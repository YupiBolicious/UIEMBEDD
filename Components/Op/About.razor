@page "/op/about"
@rendermode InteractiveServer
@inject NavigationManager Nav

<main class="hmi-shell">
    <!-- Top Header -->
    <InnerTopBar Title="About"/>

    <!-- Centered Viewport Wrapper -->
    <section class="hmi-timer-compact-viewport" data-purpose="mode-selection">
        
        <!-- Option 1: Timer -->
        <div class="hmi-option-item">
            <button type="button"
                    id="btn-timer"
                    class="hmi-tile hmi-tile-compact"
                    title="Diagnostics"
                    data-purpose="open-timer-button"
                    @onclick="NavigateToDiagnostic">
                <img src="/images/diagnostics.png" alt="Diagnostics" class="tile-icon" />
            </button>
            <span class="tile-label">
                Diagnostics
            </span>
        </div>

        <!-- Option 2: Stopwatch -->
        <div class="hmi-option-item">
            <button type="button"
                    id="btn-stopwatch"
                    class="hmi-tile hmi-tile-compact"
                    title="QuickTour"
                    data-purpose="open-stopwatch-button"
                    @onclick="NavigateToTour">
                <img src="/images/quick_tour.png" alt="Stopwatch" class="tile-icon" />
            </button>
            <span class="tile-label">
                Quick Tour
            </span>
        </div>

        <div class="hmi-option-item">
            <button type="button"
                    id="btn-stopwatch"
                    class="hmi-tile hmi-tile-compact"
                    title="ContactUs"
                    data-purpose="open-stopwatch-button"
                    @onclick="NavigateToContact">
                <img src="/images/contact-us.png" alt="Stopwatch" class="tile-icon" />
            </button>
            <span class="tile-label">
                Contact Us
            </span>
        </div>

    </section>

    <!-- Bottom Interaction Toolbar -->
    <footer class="hmi-footer" data-purpose="hmi-footer">
        <!-- Back Navigation Button -->
        <button type="button"
                id="btn-back"
                class="hmi-button"
                title="Return to Previous Screen"
                data-purpose="back-navigation"
                @onclick="NavigateBack">
            <svg class="back-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            <span>Back</span>
        </button>

        <!-- Preference Checkbox -->
        <label class="hmi-toggle-label" data-purpose="home-display-toggle-container">
            <input type="checkbox" 
                   id="chk-always-display"
                   class="hmi-checkbox" 
                   data-purpose="home-display-toggle" 
                   @onchange="ToggleHomeDisplay" />
            <span class="toggle-text">
                Always display timer on home screen
            </span>
        </label>
    </footer>
</main>

@code {
    [Parameter] public EventCallback OnNavToDiagnostic { get; set; }
    [Parameter] public EventCallback OnNavToTour { get; set; }
    [Parameter] public EventCallback OnNavToContact {get; set;}
    [Parameter] public EventCallback OnNavigateBack { get; set; }
    [Parameter] public EventCallback<bool> OnPreferenceChanged { get; set; }
    [Parameter] public bool AlwaysDisplayTimerOnHomeScreen { get; set; } = true;

    private async Task ToggleHomeDisplay(ChangeEventArgs e)
    {
        AlwaysDisplayTimerOnHomeScreen = bool.TryParse(e.Value?.ToString(), out var v) && v;
        if (OnPreferenceChanged.HasDelegate)
            await OnPreferenceChanged.InvokeAsync(AlwaysDisplayTimerOnHomeScreen);
    }
    private async Task NavigateToDiagnostic()
    {
        if (OnNavToDiagnostic.HasDelegate)
            await OnNavToDiagnostic.InvokeAsync();
        else 
            Nav.NavigateTo("/op/diagnostic");
    }

    private async Task NavigateToTour()
    {
        if (OnNavToTour.HasDelegate)
            await OnNavToTour.InvokeAsync();
        else 
            Nav.NavigateTo("/op/quicktour");
    }

    private async Task NavigateToContact()
    {
        if(OnNavToContact.HasDelegate) await OnNavToContact.InvokeAsync();
        else Nav.NavigateTo("/op/contact");
    }

    private async Task NavigateBack()
    {
        if (OnNavigateBack.HasDelegate)
            await OnNavigateBack.InvokeAsync();
        else
            Nav.NavigateTo("/operator");
    }
}