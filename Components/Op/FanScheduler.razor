@page "/op/fanscheduler"
@rendermode InteractiveServer
@inject NavigationManager Nav


<div class="hmi-shell">
    <InnerTopBar Title="Fan Scheduler"/>
        <!-- 2. Main Interactive Workspace (Centered Fan Scheduler Card) -->
        <main class="hmi-scheduler-workspace">
            
            <!-- Large Modernized Glowing Fan Scheduler Card -->
            <div class="hmi-scheduler-card @(IsSchedulerOn ? "card-active" : "card-inactive")">
                
                <!-- Blower Impeller Fan Vector Graphic Hologram -->
                <div class="hmi-fan-graphic-disc @(IsSchedulerOn ? "disc-active" : "disc-inactive")">
                    <svg class="w-20 h-20 @(IsSchedulerOn ? "animate-spin-slow text-sky-400" : "text-slate-400")" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <radialGradient id="fanHubGrad" cx="35%" cy="35%" r="65%">
                                <stop offset="0%" stop-color="#ffffff" />
                                <stop offset="50%" stop-color="#38bdf8" />
                                <stop offset="100%" stop-color="#0284c7" />
                            </radialGradient>
                            <linearGradient id="bladeGradActive" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#38bdf8" />
                                <stop offset="50%" stop-color="#0284c7" />
                                <stop offset="100%" stop-color="#0369a1" />
                            </linearGradient>
                            <linearGradient id="bladeGradInactive" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#94a3b8" />
                                <stop offset="100%" stop-color="#475569" />
                            </linearGradient>
                            <filter id="bladeGlow" x="-20%" y="-20%" width="140%" height="140%">
                                <feDropShadow dx="0" dy="0" stdDeviation="3" flood-color="#38bdf8" flood-opacity="0.6" />
                            </filter>
                        </defs>

                        <!-- Outer Rotor Guide Ring -->
                        <circle cx="50" cy="50" r="42" stroke="currentColor" stroke-width="2" stroke-dasharray="6 4" opacity="0.4" />

                        <!-- 4 Fan Blades / Impeller Wings -->
                        <g filter="@(IsSchedulerOn ? "url(#bladeGlow)" : "none")">
                            <!-- Top Blade -->
                            <path d="M 50 42 C 45 32, 40 18, 54 12 C 64 12, 60 28, 54 42 Z" fill="@(IsSchedulerOn ? "url(#bladeGradActive)" : "url(#bladeGradInactive)")" />
                            <!-- Right Blade -->
                            <path d="M 58 50 C 68 45, 82 40, 88 54 C 88 64, 72 60, 58 54 Z" fill="@(IsSchedulerOn ? "url(#bladeGradActive)" : "url(#bladeGradInactive)")" />
                            <!-- Bottom Blade -->
                            <path d="M 50 58 C 55 68, 60 82, 46 88 C 36 88, 40 72, 46 58 Z" fill="@(IsSchedulerOn ? "url(#bladeGradActive)" : "url(#bladeGradInactive)")" />
                            <!-- Left Blade -->
                            <path d="M 42 50 C 32 55, 18 60, 12 46 C 12 36, 28 40, 42 46 Z" fill="@(IsSchedulerOn ? "url(#bladeGradActive)" : "url(#bladeGradInactive)")" />
                        </g>

                        <!-- Center Blower Hub Pin -->
                        <circle cx="50" cy="50" r="10" fill="url(#fanHubGrad)" stroke="#ffffff" stroke-width="1.5" />
                        <circle cx="47" cy="47" r="3" fill="#ffffff" opacity="0.8" />
                    </svg>
                </div>

                <!-- Feature Label: "Scheduler On" verbatim as in reference -->
                <div class="hmi-feature-label">
                    <span class="text-white font-extrabold text-2xl md:text-3xl tracking-wide">
                        Scheduler:
                    </span>
                    <span class="hmi-state-indicator @(IsSchedulerOn ? "state-on" : "state-off")">
                        @(IsSchedulerOn ? "ON" : "STANDBY")
                    </span>
                </div>

                <!-- Modern Tactile Capacitive Toggle Switch -->
                <div class="hmi-toggle-container">
                    <button type="button" 
                            @onclick="ToggleScheduler" 
                            role="switch" 
                            aria-checked="@IsSchedulerOn" 
                            class="hmi-switch-track @(IsSchedulerOn ? "track-on" : "track-off")">
                        <!-- Sliding Pill Knob -->
                        <span class="hmi-switch-knob @(IsSchedulerOn ? "knob-on" : "knob-off")">
                            @if (IsSchedulerOn)
                            {
                                <svg class="knob-check" viewBox="0 0 24 24">
                                    <path d="M4.5 12.75l6 6 9-13.5" />
                                </svg>
                            }
                            else
                            {
                                <div class="knob-dot"></div>
                            }
                        </span>
                    </button>
                </div>

                <!-- Dynamic Status Caption Underneath Switch -->
                <div class="hmi-card-caption">
                    @if (IsSchedulerOn)
                    {
                        <div class="flex items-center gap-2 text-sky-200 text-sm font-medium">
                            <span class="status-pulse-dot"></span>
                            <span>Automated fan schedule is enabled and running.</span>
                        </div>
                    }
                    else
                    {
                        <div class="flex items-center gap-2 text-white/50 text-sm font-medium">
                            <span class="w-2 h-2 rounded-full bg-slate-500"></span>
                            <span>Scheduler is disabled. Fan operates under manual control.</span>
                        </div>
                    }
                </div>

            </div>

        </main>

        <!-- 3. Bottom HMI Navigation & Footer Dock -->
        <footer class="hmi-footer">
            <!-- Tactile Back Navigation Button -->
            <button type="button" @onclick="NavigateBack" class="hmi-button">
                <svg stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
                </svg>
                <span>Back</span>
            </button>
        </footer>
</div>

@code {
    [Parameter] public bool IsSchedulerOn { get; set; } = true;
    [Parameter] public EventCallback<bool> IsSchedulerOnChanged { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }

    private async Task ToggleScheduler()
    {
        IsSchedulerOn = !IsSchedulerOn;
        if (IsSchedulerOnChanged.HasDelegate)
        {
            await IsSchedulerOnChanged.InvokeAsync(IsSchedulerOn);
        }
    }

    private async Task NavigateBack()
    {
        if (OnBack.HasDelegate)
        {
            await OnBack.InvokeAsync();
        }
        else
        {
            Nav.NavigateTo("/operator");
        }
    }
}
