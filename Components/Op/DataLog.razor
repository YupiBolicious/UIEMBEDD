@page "/op/datalog"
@rendermode InteractiveServer
@inject NavigationManager Nav

<div class="hmi-shell">
    <InnerTopBar Title="Data Log" />

    <!-- Telemetry Strip: Filter + Live Clock -->
    <div class="hmi-datalog-strip">
        <div class="strip-filter">
            <button type="button" class="@(ActiveFilter == "all" ? "strip-filter-btn active" : "strip-filter-btn")" @onclick='() => SetFilter("all")'>All Logs</button>
            <button type="button" class="@(ActiveFilter == "today" ? "strip-filter-btn active" : "strip-filter-btn")" @onclick='() => SetFilter("today")'>21 Sep</button>
        </div>
    </div>

    <!-- Main Data Log Table Workspace -->
    <main class="hmi-table-workspace">
        <div class="hmi-table-container">
            <table class="hmi-log-table">
                <thead>
                    <tr>
                        <th class="th-no">No</th>
                        <th>Date</th>
                        <th>Time (24h)</th>
                        <th>Temp</th>
                        <th>Inflow</th>
                        <th>Downflow</th>
                        <th>User</th>
                    </tr>
                </thead>
            </table>
            <div class="table-scroll">
                <table class="hmi-log-table">
                    <tbody>
                    @foreach (var entry in PagedLogs)
                    {
                        <tr class="log-row @(entry.IsAdmin ? "row-admin" : "row-guest")">
                            <td class="td-no font-mono">@entry.No</td>
                            <td class="font-mono">@entry.Date</td>
                            <td class="font-mono">@entry.Time</td>
                            <td class="td-temp">
                                <span class="pill-temp font-mono">
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
                                    </svg>
                                    @entry.Temp
                                </span>
                            </td>
                            <td class="td-inflow font-mono">
                                <span class="pill-airflow-inflow">
                                    <span class="mini-flow-dot"></span>
                                    @entry.Inflow
                                </span>
                            </td>
                            <td class="td-downflow font-mono">
                                <span class="pill-airflow-downflow">
                                    <span class="mini-flow-dot"></span>
                                    @entry.Downflow
                                </span>
                            </td>
                            <td class="td-downflow font-mono">
                                <span class="badge-user">
                                    @entry.User
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
                </table>
            </div>
        </div>

        <div class="hmi-pagination-bar">
            <div class="page-nav">
                <button type="button" @onclick="FirstPage" disabled="@(CurrentPage <= 1)" class="btn-page @(CurrentPage <= 1 ? "btn-disabled" : "")" title="First Page">
                    <svg class="page-ico" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M18.75 19.5l-7.5-7.5 7.5-7.5m-6 15L5.25 12l7.5-7.5" /></svg>
                </button>
                <button type="button" @onclick="PreviousPage" disabled="@(CurrentPage <= 1)" class="btn-page @(CurrentPage <= 1 ? "btn-disabled" : "")" title="Previous Page">
                    <svg class="page-ico" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M15.75 19.5L8.25 12l7.5-7.5" /></svg>
                </button>

                <span class="page-count">
                    Page <strong class="sky">@CurrentPage</strong> of <strong class="white">@TotalPages</strong>
                </span>

                <button type="button" @onclick="NextPage" disabled="@(CurrentPage >= TotalPages)" class="btn-page @(CurrentPage >= TotalPages ? "btn-disabled" : "")" title="Next Page">
                    <svg class="page-ico" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
                </button>
                <button type="button" @onclick="LastPage" disabled="@(CurrentPage >= TotalPages)" class="btn-page @(CurrentPage >= TotalPages ? "btn-disabled" : "")" title="Last Page">
                    <svg class="page-ico" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M5.25 4.5l7.5 7.5-7.5 7.5m6-15l7.5 7.5-7.5 7.5" /></svg>
                </button>
            </div>

            <div class="page-total">
                <span>(Total log is <strong class="white">@TotalItems.ToString("N0")</strong> items)</span>
            </div>
        </div>
    </main>

    <!-- Bottom HMI Navigation & Options Dock -->
    <footer class="hmi-footer">
        <button type="button" @onclick="NavigateBack" class="hmi-button">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
            <span>Back</span>
        </button>

        <button type="button" @onclick="OpenOptions" class="hmi-button">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-9.75 0h9.75" />
            </svg>
            <span>Options</span>
        </button>
    </footer>
</div>

@code {
    public class LogEntryModel
    {
        public int No { get; set; }
        public string Date { get; set; } = "";
        public string Time { get; set; } = "";
        public string Temp { get; set; } = "";
        public string Inflow { get; set; } = "";
        public string Downflow { get; set; } = "";
        public string User { get; set; } = "";
        public bool IsAdmin => User?.Equals("Administrator", StringComparison.OrdinalIgnoreCase) == true;
    }

    [Parameter] public DateTime CurrentTime { get; set; } = new DateTime(2026, 9, 21, 10, 28, 0);
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public int TotalPages { get; set; } = 616;
    [Parameter] public int TotalItems { get; set; } = 30793;
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback OnOptions { get; set; }

    private string ActiveFilter = "all";
    private List<LogEntryModel> PagedLogs = new();

    protected override void OnInitialized()
    {
        LoadLogs();
    }

    private void LoadLogs()
    {
        PagedLogs = new List<LogEntryModel>
        {
            new() { No = 1, Date = "2026-09-21", Time = "10:26:37", Temp = "29°C", Inflow = "0.49 m/s", Downflow = "0.27 m/s", User = "Administrator" },
            new() { No = 2, Date = "2026-09-21", Time = "10:25:37", Temp = "29°C", Inflow = "0.50 m/s", Downflow = "0.28 m/s", User = "Administrator" },
            new() { No = 3, Date = "2026-09-21", Time = "10:24:37", Temp = "29°C", Inflow = "0.49 m/s", Downflow = "0.27 m/s", User = "Guest" },
            new() { No = 4, Date = "2026-09-21", Time = "10:23:37", Temp = "29°C", Inflow = "0.51 m/s", Downflow = "0.28 m/s", User = "Guest" },
            new() { No = 5, Date = "2026-09-21", Time = "10:22:37", Temp = "29°C", Inflow = "0.51 m/s", Downflow = "0.28 m/s", User = "Guest" },
            new() { No = 6, Date = "2026-09-21", Time = "10:21:37", Temp = "29°C", Inflow = "0.50 m/s", Downflow = "0.28 m/s", User = "Guest" },
            new() { No = 7, Date = "2026-09-21", Time = "10:20:37", Temp = "29°C", Inflow = "0.50 m/s", Downflow = "0.28 m/s", User = "Guest" },
            new() { No = 8, Date = "2026-09-21", Time = "10:19:37", Temp = "29°C", Inflow = "0.50 m/s", Downflow = "0.28 m/s", User = "Guest" },
        };
    }

    private void SetFilter(string filter)
    {
        ActiveFilter = filter;
    }

    private void FirstPage() => CurrentPage = 1;
    private void PreviousPage()
    {
        if (CurrentPage > 1) CurrentPage--;
    }
    private void NextPage()
    {
        if (CurrentPage < TotalPages) CurrentPage++;
    }
    private void LastPage() => CurrentPage = TotalPages;

    private async Task NavigateBack()
    {
        if (OnBack.HasDelegate)
        {
            await OnBack.InvokeAsync();
        }
        else
        {
            Nav.NavigateTo("/operator");
        }
    }

    private async Task OpenOptions()
    {
        if (OnOptions.HasDelegate)
        {
            await OnOptions.InvokeAsync();
        }
        else
        {
            Nav.NavigateTo("/op/options/datalog");
        }
    }
}