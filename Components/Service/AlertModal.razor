@inject IHmiAlertService AlertService
@implements IDisposable

@if (AlertService.IsVisible)
{
    <div class="hmi-modal-backdrop" @onclick="HandleBackdropClick" role="dialog" aria-modal="true" aria-labelledby="hmi-alert-title">
        
        <!-- Modal Card Container -->
        <div class="hmi-alert-dialog" @onclick:stopPropagation="true">
            
            <!-- 1. Header Banner with Category Title (Color varies with severity level) -->
            <div class="hmi-alert-banner @GetBannerClass(AlertService.CurrentOptions.Level)">
                <span id="hmi-alert-title" class="hmi-alert-title-text">
                    @AlertService.CurrentOptions.Title
                </span>
            </div>

            <!-- 2. Content Body: Warning Icon + Descriptive Notice -->
            <div class="hmi-alert-body">
                
                <!-- Left Warning / Status Vector Emblem -->
                <div class="hmi-alert-icon-container">
                    @switch (AlertService.CurrentOptions.Level)
                    {
                        case HmiAlertLevel.Warning:
                            <!-- Tactile Amber Triangle Warning Badge with Exclamation Mark -->
                            <svg class="hmi-alert-svg-icon" viewBox="0 0 100 90" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <defs>
                                    <linearGradient id="warnTriGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                                        <stop offset="0%" stop-color="#fef08a" />
                                        <stop offset="35%" stop-color="#facc15" />
                                        <stop offset="100%" stop-color="#eab308" />
                                    </linearGradient>
                                    <filter id="warnGlow" x="-20%" y="-20%" width="140%" height="140%">
                                        <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#ca8a04" flood-opacity="0.5" />
                                    </filter>
                                </defs>
                                <g filter="url(#warnGlow)">
                                    <path d="M 50 8 C 52 4.5, 56 4.5, 58 8 L 94 72 C 96 75.5, 94 80, 90 80 L 10 80 C 6 80, 4 75.5, 6 72 Z"
                                          fill="url(#warnTriGrad)" stroke="#ca8a04" stroke-width="2.5" stroke-linejoin="round" />
                                    <!-- Exclamation point stem & dot -->
                                    <line x1="50" y1="30" x2="50" y2="54" stroke="#1c1917" stroke-width="7" stroke-linecap="round" />
                                    <circle cx="50" cy="68" r="4.2" fill="#1c1917" />
                                </g>
                            </svg>
                            break;

                        case HmiAlertLevel.Danger:
                            <svg class="hmi-alert-svg-icon" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <circle cx="50" cy="50" r="42" fill="#ef4444" stroke="#b91c1c" stroke-width="2" />
                                <line x1="32" y1="32" x2="68" y2="68" stroke="#ffffff" stroke-width="8" stroke-linecap="round" />
                                <line x1="68" y1="32" x2="32" y2="68" stroke="#ffffff" stroke-width="8" stroke-linecap="round" />
                            </svg>
                            break;

                        case HmiAlertLevel.Success:
                            <svg class="hmi-alert-svg-icon" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <circle cx="50" cy="50" r="42" fill="#22c55e" stroke="#15803d" stroke-width="2" />
                                <polyline points="28,50 44,66 72,34" fill="none" stroke="#ffffff" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                            break;

                        default:
                            <svg class="hmi-alert-svg-icon" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <circle cx="50" cy="50" r="42" fill="#0284c7" stroke="#0369a1" stroke-width="2" />
                                <circle cx="50" cy="30" r="5" fill="#ffffff" />
                                <line x1="50" y1="44" x2="50" y2="72" stroke="#ffffff" stroke-width="8" stroke-linecap="round" />
                            </svg>
                            break;
                    }
                </div>

                <!-- Right Message Text Block -->
                <div class="hmi-alert-text-block">
                    @foreach (var line in (AlertService.CurrentOptions.Message ?? "").Split('\n'))
                    {
                        <p class="hmi-alert-line">@line</p>
                    }
                </div>

            </div>

            <!-- 3. Bottom Action Buttons Bar (Equal split: Later | Restart) -->
            <div class="hmi-alert-actions">
                @if (AlertService.CurrentOptions.ShowCancel)
                {
                    <button type="button" 
                            @onclick="AlertService.Cancel" 
                            class="hmi-dialog-btn btn-cancel">
                        @AlertService.CurrentOptions.CancelText
                    </button>
                }

                <button type="button" 
                        @onclick="AlertService.Confirm" 
                        class="hmi-dialog-btn btn-confirm @(AlertService.CurrentOptions.ShowCancel ? "" : "w-full")">
                    @AlertService.CurrentOptions.ConfirmText
                </button>
            </div>

        </div>

    </div>
}

@code {
    protected override void OnInitialized()
    {
        AlertService.OnChange += OnAlertServiceStateChanged;
    }

    private void OnAlertServiceStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void HandleBackdropClick()
    {
        if (AlertService.CurrentOptions.DismissableBackdrop)
        {
            AlertService.Cancel();
        }
    }

    private string GetBannerClass(HmiAlertLevel level) => level switch
    {
        HmiAlertLevel.Danger => "banner-danger",
        HmiAlertLevel.Info => "banner-info",
        HmiAlertLevel.Success => "banner-success",
        _ => "banner-warning" // Default orange / coral matching reference photo
    };

    public void Dispose()
    {
        AlertService.OnChange -= OnAlertServiceStateChanged;
    }
}
