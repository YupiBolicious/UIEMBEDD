@page "/service/options/{Context}"
@rendermode InteractiveServer
@inject NavigationManager NavManager

<div class="hmi-shell">
    <InnerTopBar Title="@Config.Title" />

    <!-- Options Panel Grid -->
    <section class="hmi-options">
        <div class="options-grid">

            <!-- Top Left: Enable Notification Toggle Panel -->
            <article class="options-card col-5">
                <h2 class="card-title">Enable<br />Notification</h2>
                <div>
                    <label class="toggle-switch">
                        <input type="checkbox" class="toggle-input" @bind="IsNotificationEnabled" />
                        <span class="toggle-track"></span>
                    </label>
                </div>
            </article>

            <!-- Top Middle: Notify Before Dropdown Panel -->
            <article class="options-card col-7">
                <h2 class="card-title">@Config.NotifyBefore</h2>
                <div class="select-wrap">
                    <select class="options-select" @bind="SelectedNotifyInterval">
                        <option value="15-min">15 minutes</option>
                        <option value="30-min">30 minutes</option>
                        <option value="1-hour">1 hour</option>
                        <option value="2-hour">2 hours</option>
                        <option value="1-day">1 day</option>
                    </select>
                    <svg class="select-caret" viewBox="0 0 20 20">
                        <path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" />
                    </svg>
                </div>
            </article>

            <!-- Top Right: Export Week Panel -->
            <article class="options-card col-7">
                <h2 class="card-title">@Config.ExportLabel.Replace("{week}", CurrentWeekNumber.ToString())</h2>
                <div class="export-actions">
                    <button type="button" aria-label="Export via Bluetooth" class="export-btn" @onclick="ExportBluetooth">
                        <svg class="export-ico" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" />
                        </svg>
                        <span class="export-badge sky">
                            <svg class="badge-ico" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M14.88 16.29L13 18.17V14.41m0-4.82l1.88 1.88L13 13.35M7 7.07L12.59 1.48A1 1 0 0 1 14.3 2.19v7.16l4.29-4.29a1 1 0 0 1 1.41 1.41L15.41 11l4.59 4.59a1 1 0 0 1-1.41 1.41L14.3 12.71v7.16a1 1 0 0 1-1.71.71L7 14.99a1 1 0 0 1 0-1.41l4.29-4.29L7 4.99a1 1 0 0 1 0-1.41z" />
                            </svg>
                        </span>
                    </button>

                    <button type="button" aria-label="Export to USB Drive" class="export-btn" @onclick="ExportUsb">
                        <svg class="export-ico" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" />
                        </svg>
                        <span class="export-badge light">
                            <svg class="badge-ico" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M8 2h8v4H8V2m0 6h8v9a4 4 0 0 1-8 0V8m2-4v2h1V4h-1m3 0v2h1V4h-1Z" />
                            </svg>
                        </span>
                    </button>
                </div>
            </article>

            <!-- Bottom: Delete Logs & Storage Telemetry -->
            <article class="options-card col-7">
                <h2 class="card-title">Delete logs starting from</h2>
                <div class="delete-row">
                    <div class="select-wrap flex-1">
                        <select class="options-select" @bind="SelectedDeleteCriteria">
                            <option value="today-clear-all">Today (Clear All)</option>
                            <option value="1-week-ago">Older than 1 week</option>
                            <option value="1-month-ago">Older than 1 month</option>
                            <option value="all-records">All stored records</option>
                        </select>
                        <svg class="select-caret" viewBox="0 0 20 20">
                            <path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" />
                        </svg>
                    </div>
                    <button type="button" aria-label="Delete Logs Button" class="del-btn" @onclick="DeleteLogs">
                        <svg class="del-ico" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                            <path d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </button>
                </div>
                <div class="storage-bar">
                    <span>Storage: @UsedStorage/@TotalStorage</span>
                </div>
            </article>
        </div>
    </section>

    <!-- System Navigation Bar & Regulatory Footnotes -->
    <footer class="hmi-footer">
        <button type="button" class="hmi-button" @onclick="OnBackClick">
            <svg class="back-ico" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span>Back</span>
        </button>

        <button type="button" class="options-link" @onclick="OnBackupRestoreClick">Backup/Restore</button>
    </footer>
</div>

@code {
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback OnBackupRestore { get; set; }
    [Parameter] public string? Context { get; set; }

    private record OptionConfig(string Title, string NotifyBefore, string ExportLabel, string BackRoute);

    private static readonly Dictionary<string, OptionConfig> Configs = new()
    {
        ["componentrecord"] = new(
            "Replaceable Component Record - Options",
            "Notify",
            "Export Data",
            "/service/componentrecord"),
        ["maintenance"] = new(
            "Preventive Maintenance - Options",
            "Notify",
            "Export Data",
            "/service/maintenance")
    };

    private OptionConfig Config => Configs.TryGetValue(Context ?? "", out var c) ? c : Configs["componentrecord"];

    private bool IsNotificationEnabled { get; set; } = true;
    private string SelectedNotifyInterval { get; set; } = "1-hour";
    private string SelectedDeleteCriteria { get; set; } = "today-clear-all";
    private int CurrentWeekNumber { get; set; } = 39;
    private int UsedStorage { get; set; } = 4;
    private int TotalStorage { get; set; } = 6205;

    private void ExportBluetooth()
    {
        // Add Bluetooth export handling
    }

    private void ExportUsb()
    {
        // Add USB export handling
    }

    private void DeleteLogs()
    {
        // Add log deletion logic based on SelectedDeleteCriteria
    }

    private async Task OnBackClick()
    {
        if (OnBack.HasDelegate)
            await OnBack.InvokeAsync();
        else
            NavManager.NavigateTo(Config.BackRoute);
    }

    private async Task OnBackupRestoreClick()
    {
        if (OnBackupRestore.HasDelegate)
            await OnBackupRestore.InvokeAsync();
    }
}