@page "/dashboard/lcdcleaning"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@implements IDisposable

<div class="hmi-shell">
    <InnerTopBar Title="LCD Cleaning"/>
        @if (IsCleaningActive)
        {
            <div class="hmi-blanking-overlay select-none" @onclick="AbortCleaning">
                <div class="hmi-blank-inner">
                    <svg class="hmi-blank-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
                    </svg>
                    <div class="hmi-blank-label">LCD CLEANING IN PROGRESS</div>
                    <div class="hmi-blank-sub">Touch Input Disabled for Safety</div>

                    <!-- Large Glowing Countdown -->
                    <div class="hmi-blanking-countdown">@CleaningCountdown</div>

                    <div class="hmi-blank-note">
                        Cycle ends automatically in @CleaningCountdown seconds (Tap to abort)
                    </div>
                </div>
            </div>
        }

        <!-- Main Interactive Cleaning Workspace (2 Columns) -->
        <main class="hmi-cleaning-workspace">
            
            <!-- Left Column: Capacitive Cleaning Mode Activation Card -->
            <div class="hmi-wipe-trigger-card" @onclick="StartCleaningMode">
                
                <!-- Microfiber Cloth & Hand Vector Graphic Disc -->
                <div class="hmi-cloth-graphic-disc">
                    <svg class="hmi-cloth-icon" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <linearGradient id="clothGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#ffffff" />
                                <stop offset="50%" stop-color="#f0f9ff" />
                                <stop offset="100%" stop-color="#bae6fd" />
                            </linearGradient>
                            <linearGradient id="handGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                                <stop offset="0%" stop-color="#fed7aa" />
                                <stop offset="100%" stop-color="#fdba74" />
                            </linearGradient>
                            <filter id="clothShadow" x="-20%" y="-20%" width="140%" height="140%">
                                <feDropShadow dx="0" dy="4" stdDeviation="3" flood-color="#0284c7" flood-opacity="0.35" />
                            </filter>
                        </defs>

                        <!-- Cleaning Solution Micro-Bubbles -->
                        <circle cx="24" cy="38" r="4.5" fill="#e0f2fe" opacity="0.8" />
                        <circle cx="18" cy="46" r="3" fill="#e0f2fe" opacity="0.6" />
                        <circle cx="21" cy="56" r="2" fill="#e0f2fe" opacity="0.5" />

                        <!-- Microfiber Cleaning Cloth Sheet -->
                        <g filter="url(#clothShadow)">
                            <path d="M 32 20 C 38 18, 62 18, 68 22 C 74 26, 76 52, 72 58 C 66 64, 40 64, 34 60 C 28 56, 26 24, 32 20 Z" 
                                  fill="url(#clothGrad)" stroke="#38bdf8" stroke-width="1.8" stroke-linejoin="round" />
                            
                            <!-- Microfiber Cloth Textured Weave Folds -->
                            <path d="M 38 28 C 46 26, 60 26, 64 30" stroke="#0284c7" stroke-width="1" stroke-linecap="round" opacity="0.4" stroke-dasharray="2 2" />
                            <path d="M 36 36 C 46 34, 60 34, 66 38" stroke="#0284c7" stroke-width="1" stroke-linecap="round" opacity="0.4" stroke-dasharray="2 2" />
                            <path d="M 34 44 C 44 42, 58 42, 64 46" stroke="#0284c7" stroke-width="1" stroke-linecap="round" opacity="0.4" stroke-dasharray="2 2" />
                        </g>

                        <!-- Stylized Wiping Hand Touching Cloth -->
                        <g filter="url(#clothShadow)">
                            <!-- Palm Base & Fingers -->
                            <path d="M 44 64 C 42 56, 43 45, 47 43 C 49 41, 52 42, 52 47 L 52 42 C 52 39, 56 39, 56 42 L 56 41 C 56 38, 60 38, 60 42 L 60 44 C 60 42, 64 42, 64 46 C 64 54, 62 68, 56 70 Z" 
                                  fill="url(#handGrad)" stroke="#fb923c" stroke-width="1.2" stroke-linejoin="round" />
                            <!-- Palm creases -->
                            <path d="M 47 54 C 51 56, 57 56, 60 54" stroke="#ea580c" stroke-width="1" stroke-linecap="round" opacity="0.4" />
                        </g>

                        <!-- Circular Motion Swipe Beam -->
                        <path d="M 26 72 A 38 38 0 0 1 76 72" fill="none" stroke="#38bdf8" stroke-width="2" stroke-linecap="round" stroke-dasharray="4 4" opacity="0.65" />
                    </svg>
                </div>

                <!-- Primary Prompt Text -->
                <div class="hmi-wipe-prompt">
                    Tap here to start.
                </div>

                <!-- Duration Pill Badge -->
                <div class="hmi-cycle-badge">
                    <svg class="hmi-badge-icon" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span>15 SECONDS DEACTIVATION CYCLE</span>
                </div>

                <div class="hmi-wipe-caption">
                    Screen touch sensors will lock temporarily to allow thorough sanitization.
                </div>

            </div>

            <!-- Right Column: Attention & Cleaning Safety Protocol Card -->
            <div class="hmi-attention-card">
                
                <div>
                    <!-- Header -->
                    <div class="hmi-attention-title">
                        <div>
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
                            </svg>
                        </div>
                        <span>Attention!</span>
                    </div>

                    <!-- Verbatim Protocol Checklist -->
                    <ul class="hmi-instruction-list">
                        <li class="hmi-instruction-item">
                            <span class="hmi-instruction-bullet">#</span>
                            <span>Recommended to wipe the surface with a lint-free microfiber cloth.</span>
                        </li>
                        <li class="hmi-instruction-item">
                            <span class="hmi-instruction-bullet">#</span>
                            <span>Never directly apply cleaning solution to the screen.</span>
                        </li>
                        <li class="hmi-instruction-item">
                            <span class="hmi-instruction-bullet">#</span>
                            <span>Do not use the moist section of the cloth to clean the corners of the screen.</span>
                        </li>
                        <li class="hmi-instruction-item">
                            <span class="hmi-instruction-bullet">#</span>
                            <span>Start from the center and gently wipe the screen in a circular motion.</span>
                        </li>
                        <li class="hmi-instruction-item">
                            <span class="hmi-instruction-bullet">#</span>
                            <span>Upon starting, the screen will go blank and then back to normal after 15 seconds.</span>
                        </li>
                    </ul>
                </div>
            </div>

        </main>

        <!-- Bottom HMI Dock Navigation Bar -->
        <footer class="hmi-footer">
            <!-- Back Navigation Button -->
            <button type="button" @onclick="NavigateBack" class="hmi-button">
                <svg class="hmi-foot-ico" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
                </svg>
                <span>Back</span>
            </button>

            <!-- Direct Start Action Button -->
            <button type="button" @onclick="StartCleaningMode" class="hmi-button">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z" />
                </svg>
                <span>Start Cleaning Mode</span>
            </button>
        </footer>
</div>
@code {
    [Parameter] public int DurationSeconds { get; set; } = 15;
    [Parameter] public EventCallback OnCleaningStarted { get; set; }

    [Parameter] public EventCallback OnCleaningFinished { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }

    private DateTime CurrentTime = new DateTime(2026, 9, 21, 10, 28, 0);
    private bool IsCleaningActive = false;
    private int CleaningCountdown = 15;
    private System.Threading.Timer? CountdownTimer;

    private async Task StartCleaningMode()
    {
        if (IsCleaningActive) return;

        IsCleaningActive = true;
        CleaningCountdown = DurationSeconds;

        if (OnCleaningStarted.HasDelegate)
        {
            await OnCleaningStarted.InvokeAsync();
        }

        CountdownTimer?.Dispose();
        CountdownTimer = new System.Threading.Timer(async _ =>
        {
            if (CleaningCountdown > 1)
            {
                CleaningCountdown--;
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                await StopCleaningMode();
            }
        }, null, 1000, 1000);
    }

    private async Task StopCleaningMode()
    {
        CountdownTimer?.Dispose();
        CountdownTimer = null;
        IsCleaningActive = false;
        CleaningCountdown = DurationSeconds;

        if (OnCleaningFinished.HasDelegate)
        {
            await OnCleaningFinished.InvokeAsync();
        }

        await InvokeAsync(StateHasChanged);
    }

    private void AbortCleaning()
    {
        _ = StopCleaningMode();
    }

    private async Task NavigateBack()
    { 
        Navigation.NavigateTo("/operator");
    }

    public void Dispose()
    {
        CountdownTimer?.Dispose();
    }
}
