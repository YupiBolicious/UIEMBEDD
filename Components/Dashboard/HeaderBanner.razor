@inject CabinetStateService Cabinet
@inject HeaderStateService Header
@implements IDisposable

<header class="top-status-bar">
    <div class="brand-slot">
        <EscoBrand />
    </div>
    @if (Header.Mode == HeaderMode.Status)
    {
        <div class="safety-banner @(Cabinet.IsSafe ? "safe" : "alarm")">
            <span class="safety-text">@(Cabinet.IsSafe ? "CABINET IS SAFE" : "CABINET ALARM")</span>
        </div>
    }
    else if (Header.Mode == HeaderMode.Title)
    {
        <div class="title-banner">
            <span class="title-text">@Header.Title</span>
            <span class="title-date">@Cabinet.DateText</span>
        </div>
    }
</header>

@code {
    protected override void OnInitialized()
    {
        Cabinet.OnChange += HandleStateChanged;
        Header.OnChange += HandleStateChanged;
    }

    private void HandleStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Cabinet.OnChange -= HandleStateChanged;
        Header.OnChange -= HandleStateChanged;
    }
}
