@page "/dashboard/lightintensity"
@using Microsoft.AspNetCore.Components.Web
@rendermode InteractiveServer
@inject NavigationManager Navigation

<div class="hmi-shell">
<InnerTopBar Title="Light Intensity Setting"/>

    <!-- Main Interactive Workspace -->
    <main class="hmi-workspace">
        
        <!-- Bright Numeric Intensity Percentage -->
        <div class="intensity-value">
            @(Intensity)%
        </div>

        <!-- Horizontal Capsule Slider Assembly -->
        <div class="slider-container">
            
            <!-- Sun Icon Anchor -->
            <div class="slider-icon">
                <svg class="w-8 h-8 stroke-white stroke-[2.2] fill-none drop-shadow-sm" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="4.2" stroke="currentColor" fill="currentColor" fill-opacity="0.2" />
                    <line x1="12" y1="1.8" x2="12" y2="4.5" stroke-linecap="round" />
                    <line x1="12" y1="19.5" x2="12" y2="22.2" stroke-linecap="round" />
                    <line x1="1.8" y1="12" x2="4.5" y2="12" stroke-linecap="round" />
                    <line x1="19.5" y1="12" x2="22.2" y2="12" stroke-linecap="round" />
                    <line x1="4.77" y1="4.77" x2="6.68" y2="6.68" stroke-linecap="round" />
                    <line x1="17.32" y1="17.32" x2="19.23" y2="19.23" stroke-linecap="round" />
                    <line x1="4.77" y1="19.23" x2="6.68" y2="17.32" stroke-linecap="round" />
                    <line x1="17.32" y1="6.68" x2="19.23" y2="4.77" stroke-linecap="round" />
                </svg>
            </div>

            <!-- Active Progress Fill Glow -->
            <div class="slider-fill" style="width: @(FillWidthPercentage)%;"></div>

            <!-- Native Range Input (Handled via @oninput for smooth server synchronization) -->
            <input type="range" 
                   min="10" 
                   max="100" 
                   step="1" 
                   value="@Intensity" 
                   @oninput="HandleSliderInput"
                   @onchange="HandleSliderChange"
                   class="slider-input" />

            <!-- Thumb Handle -->
            <div class="slider-thumb" style="left: @(ThumbLeftPosition);">
                <div class="thumb-grip"></div>
                <div class="thumb-grip"></div>
            </div>
        </div>

        <!-- Auto-Dimming Timeout Configuration -->
        <div class="dim-group">
            <div class="relative">
                <select value="@DimTimeout" @onchange="OnDimTimeoutChanged" class="dim-select">
                    <option value="1 minute">1 minute</option>
                    <option value="2 minutes">2 minutes</option>
                    <option value="5 minutes">5 minutes</option>
                    <option value="10 minutes">10 minutes</option>
                    <option value="Never">Never</option>
                </select>
                <div class="dim-caret">
                    <svg class="w-4 h-4 fill-none stroke-currentColor stroke-[3]" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                    </svg>
                </div>
            </div>
            <span class="dim-label">to dim automatically</span>
        </div>

        <!-- Lock Screen Checkbox Toggle -->
        <label class="lock-toggle group select-none">
            <div class="checkbox-wrapper">
                <input type="checkbox" checked="@EnableLockScreen" @onchange="OnEnableLockScreenChanged" class="checkbox-input" />
                @if (EnableLockScreen)
                {
                    <svg class="checkbox-check" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                    </svg>
                }
            </div>
            <span class="lock-label">
                Enable lock screen
            </span>
        </label>

        <!-- Footnote -->
        <div class="footnote-text">
            *If the lock screen is enabled, the screen will be locked when auto-dim is activated.
        </div>

    </main>

    <!-- Bottom Dock Navigation Bar -->
    <footer class="hmi-footer">
        <button type="button" @onclick="NavigateBack" class="hmi-button">
            <svg class="w-5 h-5 stroke-[3]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
            <span>Back</span>
        </button>
    </footer>

</div>

@code {
    [Parameter] public int Intensity { get; set; } = 100;
    [Parameter] public EventCallback<int> IntensityChanged { get; set; }

    [Parameter] public string DimTimeout { get; set; } = "1 minute";
    [Parameter] public EventCallback<string> DimTimeoutChanged { get; set; }

    [Parameter] public bool EnableLockScreen { get; set; } = true;
    [Parameter] public EventCallback<bool> EnableLockScreenChanged { get; set; }

    [Parameter] public EventCallback OnBack { get; set; }

    // Accurate calculation for fill width taking icon offsets into account
    private double FillWidthPercentage => Math.Max(0, Math.Min(100, Intensity));

    // Accurate thumb position formula accounting for thumb width (56px) across track width
    private string ThumbLeftPosition => $"calc({Intensity}% - {(Intensity * 0.56)}px)";

    private async Task HandleSliderInput(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            Intensity = val;
            if (IntensityChanged.HasDelegate)
            {
                await IntensityChanged.InvokeAsync(Intensity);
            }
        }
    }

    private async Task HandleSliderChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            Intensity = val;
            if (IntensityChanged.HasDelegate)
            {
                await IntensityChanged.InvokeAsync(Intensity);
            }
        }
    }

    private async Task OnDimTimeoutChanged(ChangeEventArgs e)
    {
        DimTimeout = e.Value?.ToString() ?? "1 minute";
        if (DimTimeoutChanged.HasDelegate)
        {
            await DimTimeoutChanged.InvokeAsync(DimTimeout);
        }
    }

    private async Task OnEnableLockScreenChanged(ChangeEventArgs e)
    {
        if (bool.TryParse(e.Value?.ToString(), out bool val))
        {
            EnableLockScreen = val;
            if (EnableLockScreenChanged.HasDelegate)
            {
                await EnableLockScreenChanged.InvokeAsync(EnableLockScreen);
            }
        }
    }

    private async Task NavigateBack()
    {
        if (OnBack.HasDelegate)
        {
            await OnBack.InvokeAsync();
        }
        else
        {
            Navigation.NavigateTo("/operator");
        }
    }
}