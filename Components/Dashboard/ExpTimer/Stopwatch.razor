@page "/dashboard/exptimer/stopwatch"
@using Microsoft.AspNetCore.Components.Web
@implements IDisposable
@inject NavigationManager Navigation
@rendermode InteractiveServer

<div class="hmi-shell">
    <InnerTopBar Title="Stopwatch" />

    <!-- Center Workspace -->
    <main class="center-workspace">

        @if (!isRunning && !isPaused)
        {
            @* IDLE MODE: READY TO START *@
            <div class="drum-picker-card">
                <div class="gloss-overlay"></div>

                <div class="picker-header">
                    <span class="format-label">STOPWATCH READY</span>
                </div>

                <div class="wheel-section" style="justify-content: center; align-items: center; padding: 2rem 0;">
                    <div class="countdown-readout">
                        <span class="live-digits" style="font-size: 3rem; font-weight: bold;">@FormattedElapsedTime</span>
                    </div>
                </div>
            </div>

            @* Start Pushbutton  *@
            <button type="button"
                    @onclick="StartStopwatch"
                    title="Start Stopwatch"
                    class="start-play-btn">
                <div class="btn-glare"></div>
                <svg class="play-icon" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z"/>
                </svg>
            </button>
        }
        else
        {
            @* RUNNING / PAUSED MODE  *@
            <div class="timer-running-card">
                <div class="gloss-overlay"></div>

                <!-- Stopwatch Readout Container -->
                <div class="progress-ring-wrapper">
                    <div class="countdown-readout">
                        <span class="live-digits" style="font-size: 3.5rem; font-weight: bold;">@FormattedElapsedTime</span>
                        @* <span class="progress-percent">@ (isPaused ? "PAUSED" : "RUNNING")</span> *@
                    </div>
                </div>
            </div>

            @* Action Controls: Pause/Resume & Reset Buttons  *@
            <div class="running-controls-group">
                @if (isRunning)
                {
                    <button type="button" @onclick="PauseStopwatch" class="hmi-action-btn pause-btn" title="Pause Stopwatch">
                        <svg viewBox="0 0 24 24" class="action-icon">
                            <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
                        </svg>
                        <span>PAUSE</span>
                    </button>
                }
                else
                {
                    <button type="button" @onclick="ResumeStopwatch" class="hmi-action-btn resume-btn" title="Resume Stopwatch">
                        <svg viewBox="0 0 24 24" class="action-icon">
                            <path d="M8 5v14l11-7z"/>
                        </svg>
                        <span>RESUME</span>
                    </button>
                }

                <button type="button" @onclick="StopStopwatch" class="hmi-action-btn reset-btn" title="Stop Stopwatch">
                    <svg viewBox="0 0 24 24" class="action-icon">
                        <path d="M6 6h12v12H6z"/>
                    </svg>
                    <span>STOP</span>
                </button>

                <button type="button" @onclick="ResetStopwatch" class="hmi-action-btn reset-btn" title="Reset Stopwatch">
                    <svg viewBox="0 0 24 24" class="action-icon">
                        <path d="M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z"/>
                    </svg>
                    <span>RESET</span>
                </button>
            </div>
        }

    </main>

    <!-- Bottom Navigation Dock -->
    <footer class="hmi-footer" data-purpose="hmi-footer">
        <button type="button"
                id="btn-back"
                class="hmi-button"
                title="Return to Previous Screen"
                data-purpose="back-navigation"
                @onclick="OnBackClicked">
            <svg class="back-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            <span>Back</span>
        </button>

        <div class="telemetry-info">
            <span>Elapsed: <strong class="text-cyan">@FormattedElapsedTime</strong></span>
            <span class="telemetry-divider">|</span>
            <span>Status: <strong>@(isRunning ? "Running" : isPaused ? "Paused" : "Stopped")</strong></span>
            <span class="telemetry-divider">|</span>
            <span>HMI Touch Target: Active</span>
        </div>
    </footer>
</div>

@code {
    // PARAMETERS & BOUND VALUES
    [Parameter] public EventCallback<TimeSpan> OnStopwatchStarted { get; set; }
    [Parameter] public EventCallback<TimeSpan> OnStopwatchStopped { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }

    // STOPWATCH EXECUTION STATE
    private int elapsedSeconds = 0;
    private bool isRunning = false;
    private bool isPaused = false;
    private CancellationTokenSource? cts;

    // FORMATTED OUTPUTS
    private string FormattedElapsedTime =>
        TimeSpan.FromSeconds(elapsedSeconds).ToString(@"hh\:mm\:ss");

    private TimeSpan ElapsedTimeSpan => TimeSpan.FromSeconds(elapsedSeconds);

    // STOPWATCH CONTROLS
    private async Task StartStopwatch()
    {
        if (isRunning) return;

        isRunning = true;
        isPaused = false;

        if (OnStopwatchStarted.HasDelegate)
        {
            await OnStopwatchStarted.InvokeAsync(ElapsedTimeSpan);
        }

        RunStopwatchLoop();
    }

    private void RunStopwatchLoop()
    {
        // Cancel existing task if running
        cts?.Cancel();
        cts?.Dispose();
        cts = new CancellationTokenSource();

        var token = cts.Token;

        _ = Task.Run(async () =>
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));

            try
            {
                while (await timer.WaitForNextTickAsync(token))
                {
                    elapsedSeconds++;

                    // Trigger UI re-render on each tick
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (OperationCanceledException)
            {
            }
        }, token);
    }

    private void PauseStopwatch()
    {
        cts?.Cancel();
        isRunning = false;
        isPaused = true;
        StateHasChanged();
    }

    private async Task ResumeStopwatch()
    {
        if (isPaused)
        {
            isRunning = true;
            isPaused = false;
            RunStopwatchLoop();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task StopStopwatch()
    {
        cts?.Cancel();
        isRunning = false;
        isPaused = false;

        if (OnStopwatchStopped.HasDelegate)
        {
            await OnStopwatchStopped.InvokeAsync(ElapsedTimeSpan);
        }

        StateHasChanged();
    }

    private void ResetStopwatch()
    {
        cts?.Cancel();
        isRunning = false;
        isPaused = false;
        elapsedSeconds = 0;
        StateHasChanged();
    }

    private async Task OnBackClicked()
    {
        if (OnBack.HasDelegate)
        {
            await OnBack.InvokeAsync();
        }
        else
        {
            Navigation.NavigateTo("/dashboard/exptimer/main");
        }
    }

    public void Dispose()
    {
        cts?.Cancel();
        cts?.Dispose();
    }
}