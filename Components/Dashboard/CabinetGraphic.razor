@inject CabinetStateService State
@implements IDisposable

<div class="bsc-cabinet-wrapper @Class" style="@Style">
    <div class="bsc-viewport">
        <!-- 1. Base 3D Cabinet Housing (swaps per condition) -->
        <img src="@BaseImage"
             alt="ESCO Biosafety Cabinet Base"
             class="bsc-layer bsc-layer-base" />

        <!-- 2. Status OK Checkmark (only in Safe condition) -->
        @if (State.Condition == CabinetCondition.Safe && ShowStatusOk && IsSafe)
        {
            <img src="/images/checkmark.png"
                 alt="Cabinet Safe Status Checkmark"
                 class="bsc-layer bsc-layer-status status-visible" />
        }

        <!-- 3. UV ON interior glow overlay -->
        @if (State.Condition == CabinetCondition.UvOn)
        {
            <div class="bsc-uv-glow" title="UV light is on"></div>
            <img src="/images/uv-sash.png"
                 alt="UV Sash Indicator"
                 class="bsc-layer bsc-layer-uv-sash" />
        }
        else if (IsBlowerActive)
        {
            <!-- 4. Downflow Laminar Airflow Stream (Descending HEPA Clean Air) -->
            <div class="bsc-stream bsc-stream-downflow" title="Downflow Velocity: @DownflowVelocity">
                <img src="@DownArrowImage"
                     alt="Downflow Airflow Arrows Primary"
                     class="bsc-layer bsc-arrow-df df-wave-1 @ArrowFilterClass" />
                <img src="@DownArrowImage"
                     alt="Downflow Airflow Arrows Secondary"
                     class="bsc-layer bsc-arrow-df df-wave-2 @ArrowFilterClass" />
            </div>

            <!-- 5. Inflow Air Intake Streams (Front Sash Air Barrier Suction) -->
            <div class="bsc-stream bsc-stream-inflow" title="Inflow Velocity: @InflowVelocity">
                <img src="@ElbowArrowImage"
                     alt="Inflow Airflow Elbow Vector Primary"
                     class="bsc-layer bsc-arrow-if if-elbow-1 @ArrowFilterClass" />
                <img src="@ElbowArrowImage"
                     alt="Inflow Airflow Elbow Vector Secondary"
                     class="bsc-layer bsc-arrow-if if-elbow-2 @ArrowFilterClass" />
                <img src="@ElbowArrowImage"
                     alt="Inflow Airflow Intake Vector"
                     class="bsc-layer bsc-arrow-if if-base-1 @ArrowFilterClass" />
            </div>
        }
        else
        {
            <!-- Standby / Blower Off Overlay Indicator -->
            <div class="bsc-standby-indicator">
                <span class="bsc-standby-badge">BLOWER OFF</span>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public bool IsBlowerActive { get; set; } = true;
    [Parameter] public bool IsSafe { get; set; } = true;
    [Parameter] public bool ShowStatusOk { get; set; } = true;
    [Parameter] public string DownflowVelocity { get; set; } = "0.32 m/s";
    [Parameter] public string InflowVelocity { get; set; } = "0.45 m/s";
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public string Style { get; set; } = "";
    [Parameter] public string MachineGraphicPath { get; set; } = "/images/cabinet-graphic.png";

    private string BaseImage => State.Condition switch
    {
        CabinetCondition.AirflowFail => "/images/BSC3Dbase-red.png",
        CabinetCondition.WarmingUp => "/images/BSC3Dbase-orange.png",
        CabinetCondition.UvOn => "/images/BSC3Dbase.png",
        _ => "/images/BSC3Dbase.png"
    };

    private string DownArrowImage => State.Condition switch
    {
        CabinetCondition.AirflowFail => "/images/down-arror-red.png",
        _ => "/images/down-arrow-green.png"
    };

    private string ElbowArrowImage => State.Condition switch
    {
        CabinetCondition.AirflowFail => "/images/elbow-arrow-red.png",
        _ => "/images/elbow-arrow-green.png"
    };

    // For states without dedicated colored arrow assets, CSS-filter the green arrows
    private string ArrowFilterClass => State.Condition switch
    {
        CabinetCondition.WarmingUp => "arrow-warming",
        CabinetCondition.UvOn => "arrow-uv",
        _ => ""
    };

    protected override void OnInitialized()
    {
        State.OnChange += OnStateChanged;
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        State.OnChange -= OnStateChanged;
    }
}
