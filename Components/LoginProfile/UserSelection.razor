@page "/user-selection"
@rendermode InteractiveServer
@attribute [AllowAnonymous]
@inject CabinetStateService State
@inject HeaderStateService Header
@inject NavigationManager Nav
@inject AppAuthStateProvider Auth

<main class="hmi-shell">
    <InnerTopBar Title="User"/>
    <section class="user-grid">
        @foreach (var columnGroup in UserColumns)
        {
            <div class="user-column">
                @foreach (var user in columnGroup)
                {
                    <button class="user-card"
                            @onclick="() => PromptPin(user)"
                            type="button">

                        <div class="avatar">@user.DisplayName[0]</div>
                        <div class="user-info">
                            <div class="user-name">
                                @user.DisplayName
                            </div>

                            <div class="username">
                                @user.Username
                            </div>

                            <div class="last-login">
                                @user.LastLoginDisplay
                            </div>
                        </div>
                    </button>
                }
            </div>
        }
    </section>

    <!-- Bottom Toolbar -->
    <footer class="hmi-footer">
        <div class="footer-actions">
            <button class="hmi-button"
                    @onclick="NavigateBack"
                    type="button">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                <span>Back</span>
            </button>

            <button class="hmi-button" @onclick="NavigateToRegister" type="button">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <path d="M19 8v6m-3-3h6" />
                </svg>
                <span>Add User</span>
            </button>
        </div>
    </footer>

    @if (_showPin)
    {
        <PinPromptDialog Title="@_selectedUser?.DisplayName"
                         OnSubmitPin="OnPinSubmitted"
                         OnCancel="OnPinCancelled" />
    }

    <div class="hmi-toast @(_toastVisible ? "show" : "")">
        <span class="toast-pulse"></span>
        <span>@_toastMessage</span>
    </div>
</main>

@code {
    private bool _showPin;
    private UserProfile? _selectedUser;

    private bool _toastVisible;
    private string _toastMessage = string.Empty;

    public record UserProfile(
        string DisplayName, 
        string Username, 
        string Role, 
        int ColumnIndex, 
        DateTime? LastLogin = null)
    {
        public string LastLoginDisplay => LastLogin?.ToString("yyyy-MM-dd HH:mm") ?? string.Empty;
    }

    private readonly List<UserProfile> Users = new()
    {
        new("Factory", "factory", "Operator", ColumnIndex: 1),
        new("Operator", "operator", "Operator", ColumnIndex: 1),
        new("Administrator", "admin", "Admin", ColumnIndex: 2),
        new("Technician", "service", "Service", ColumnIndex: 3)
    };

    private IEnumerable<IGrouping<int, UserProfile>> UserColumns => 
        Users.GroupBy(u => u.ColumnIndex).OrderBy(g => g.Key);

    protected override void OnInitialized()
    {
        Header.ShowStatus();
    }

    private void PromptPin(UserProfile user)
    {
        _selectedUser = user;
        _showPin = true;
    }

    private void OnPinCancelled()
    {
        _showPin = false;
        _selectedUser = null;
    }

    private async Task OnPinSubmitted(string pin)
    {
        if (_selectedUser == null) return;

        _showPin = false;

        if (await Auth.LoginAsync(_selectedUser.DisplayName, _selectedUser.Role, pin))
        {
            State.SetOperator(_selectedUser.DisplayName);
            Nav.NavigateTo(NavigationUtils.SafeReturnUrl(Nav) ?? "/user");
        }
        else
        {
            ShowToast("Invalid PIN");
        }
    }

    private void ShowToast(string message)
    {
        _toastMessage = message;
        _toastVisible = true;
        StateHasChanged();
    }

    private void NavigateToRegister()
    {
        Nav.NavigateTo("/user-registration");
    }

    private void NavigateBack()
    {
        Nav.NavigateTo("/");
    }
}