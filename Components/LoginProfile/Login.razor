@page "/login"
@rendermode InteractiveServer
@attribute [AllowAnonymous]
@inject CabinetStateService State
@inject HeaderStateService Header
@inject NavigationManager Nav
@inject AppAuthStateProvider Auth
@inject IJSRuntime JS
@implements IDisposable

<main class="hmi-shell">
    <InnerTopBar Title="Login" />

    @* Components/HmiLoginView.razor *@

    <section class="hmi-screen-container">
        <div class="hmi-scanlines"></div>

        @* Center Content: Username & Password Inputs *@
        <div class="hmi-center-view">
            <div class="hmi-form-stack">
                
                @* Username Field *@
                <div class="hmi-input-pill">
                    <button type="button" 
                            class="hmi-badge-cyan" 
                            @onclick="OnSelectUserTap"
                            title="Select User">
                        <span class="badge-text-top">Select user</span>
                        <svg class="badge-icon" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
                        </svg>
                        <span class="badge-text-bottom">Tap here</span>
                    </button>

                    <div class="input-wrapper">
                        <input type="text" 
                            class="hmi-input" 
                            @bind-value="Username" 
                            placeholder="Username" />
                    </div>
                </div>

                @* Password Field *@
                <div class="hmi-input-pill">
                    <div class="hmi-badge-cyan static">
                        <svg class="badge-icon" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
                        </svg>
                    </div>

                    <div class="input-wrapper">
                        <input type="password" 
                            class="hmi-input password" 
                            @bind-value="Password" 
                            placeholder="Password" 
                            @onkeyup="HandleKeyUp" />
                    </div>
                </div>

            </div>
        </div>

        @* Bottom Control Dock *@
        <footer class="hmi-bottom-dock">
            <button type="button" class="hmi-button" @onclick="OnBackClicked">
                <svg class="btn-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
                <span>Back</span>
            </button>

            <button type="button" class="hmi-button" @onclick="HandleLogin">
                <div class="icon-circle">
                    <svg class="circle-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                    </svg>
                </div>
                <span>Login</span>
            </button>
        </footer>
    </section>
    @* HMI Feedback Toast *@
    <div class="hmi-toast @(_toastVisible ? "show" : "")">
        <span class="toast-pulse"></span>
        <span>@_toastMessage</span>
    </div>
</main>

@code {
    public string Username { get; set; } = "";
    public string Password { get; set; } = "";
    private bool _toastVisible;
    private string _toastMessage = "";
    private int _toastSeq;

    protected override void OnInitialized() => Header.ShowStatus();

    private void OnSelectUserTap() => Nav.NavigateTo("/user-selection");

    private async Task OnBackClicked() => await JS.InvokeVoidAsync("history.back");

    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(Username)) return;
        var role = AppAuthStateProvider.RoleForName(Username);
        if (await Auth.LoginAsync(Username.Trim(), role, Password))
        {
            State.SetOperator(Username.Trim());
            Nav.NavigateTo(NavigationUtils.SafeReturnUrl(Nav) ?? "/user");
        }
        else
        {
            ShowToast("Invalid PIN");
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HandleLogin();
        }
    }

    private async void ShowToast(string message)
    {
        _toastMessage = message;
        _toastVisible = true;
        var seq = ++_toastSeq;
        await Task.Delay(1800);
        if (seq == _toastSeq)
        {
            _toastVisible = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose() => Header.ShowStatus();
}