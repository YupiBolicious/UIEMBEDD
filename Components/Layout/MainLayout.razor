@inherits LayoutComponentBase
@inject CabinetStateService State
@inject NavigationManager Nav
@implements IDisposable

<div class="hmi-page @PageClass">
    <div class="hmi-frame">
        @Body
    </div>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    protected override void OnInitialized() => State.OnChange += OnStateChanged;

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private string PageClass =>
        (Nav.Uri is "/" or "") && State.Condition is CabinetCondition.AirflowFail
            or CabinetCondition.SashUnsafe
            or CabinetCondition.EnvTempHigh ? "screen-alarm" : "";

    public void Dispose() => State.OnChange -= OnStateChanged;
}
