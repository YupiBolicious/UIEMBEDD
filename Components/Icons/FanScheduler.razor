<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" width="120" height="120">
  <defs>
    <!-- ESCO Deep Navy Glass Background -->
    <linearGradient id="esco_bg_fs" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#071E3D"/>
      <stop offset="100%" stop-color="#020B18"/>
    </linearGradient>

    <!-- Calendar Banner Gradient (ESCO Cyan) -->
    <linearGradient id="fsHeaderGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00E5FF"/>
      <stop offset="100%" stop-color="#0284C7"/>
    </linearGradient>

    <!-- Glowing Cyan/Amber Fan Blade Gradient -->
    <linearGradient id="fanBladeGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00E5FF"/>
      <stop offset="100%" stop-color="#38BDF8"/>
    </linearGradient>

    <filter id="fs_cal_glow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="0" stdDeviation="3.5" flood-color="#00E5FF" flood-opacity="0.45"/>
    </filter>

    <filter id="fan_blade_glow" x="-25%" y="-25%" width="150%" height="150%">
      <feDropShadow dx="0" dy="0" stdDeviation="3" flood-color="#00E5FF" flood-opacity="0.6"/>
    </filter>
  </defs>

  <!-- ESCO Outer Bezel -->
  <rect x="2" y="2" width="116" height="116" rx="24" fill="url(#esco_bg_fs)" stroke="#0E3A66" stroke-width="2"/>
  <rect x="5" y="5" width="110" height="110" rx="21" fill="none" stroke="#00D2FF" stroke-width="1" stroke-opacity="0.25"/>

  <!-- Calendar Schedule Chassis -->
  <g filter="url(#fs_cal_glow)">
    <!-- Calendar Card Base -->
    <rect x="22" y="27" width="76" height="66" rx="10" fill="#04162C" stroke="#00D2FF" stroke-width="1.8"/>

    <!-- Calendar Header Banner -->
    <path d="M 22 37 C 22 31.5 26.5 27 32 27 L 88 27 C 93.5 27 98 31.5 98 37 L 98 44 L 22 44 Z" fill="url(#fsHeaderGrad)"/>

    <!-- Binder Loops / Pegs -->
    <rect x="34" y="22" width="4.5" height="9" rx="2" fill="#E0F2FE"/>
    <rect x="58" y="22" width="4.5" height="9" rx="2" fill="#E0F2FE"/>
    <rect x="82" y="22" width="4.5" height="9" rx="2" fill="#E0F2FE"/>

    <!-- Central Fan Chamber Dial -->
    <circle cx="60" cy="67" r="18" fill="#020B18" stroke="#0E3A66" stroke-width="2"/>
    <circle cx="60" cy="67" r="18" fill="none" stroke="#00D2FF" stroke-width="1.2" stroke-dasharray="3 2" opacity="0.6"/>
  </g>

  <!-- Illuminated Cyan Fan Blades (Centrifugal/Axial Impeller) -->
  <g filter="url(#fan_blade_glow)">
    <!-- 4 Rotational Fan Petals -->
    <!-- Top Blade -->
    <path d="M 60 67 C 56 61, 54 53, 60 52 C 66 53, 64 61, 60 67 Z" fill="url(#fanBladeGrad)"/>
    <!-- Right Blade -->
    <path d="M 60 67 C 66 63, 74 61, 75 67 C 74 73, 66 71, 60 67 Z" fill="url(#fanBladeGrad)"/>
    <!-- Bottom Blade -->
    <path d="M 60 67 C 64 73, 66 81, 60 82 C 54 81, 56 73, 60 67 Z" fill="url(#fanBladeGrad)"/>
    <!-- Left Blade -->
    <path d="M 60 67 C 54 71, 46 73, 45 67 C 46 61, 54 63, 60 67 Z" fill="url(#fanBladeGrad)"/>

    <!-- Center Hub Pin -->
    <circle cx="60" cy="67" r="3.5" fill="#FFFFFF"/>
    <circle cx="60" cy="67" r="2" fill="#00E5FF"/>
  </g>
</svg>