 <svg viewBox="0 0 100 100" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <linearGradient id="speakerGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#38bdf8" />
                    <stop offset="50%" stop-color="#0284c7" />
                    <stop offset="100%" stop-color="#0369a1" />
                </linearGradient>
                <filter id="muteShadow" x="-20%" y="-20%" width="140%" height="140%">
                    <feDropShadow dx="0" dy="3" stdDeviation="2.5" flood-color="#0284c7" flood-opacity="0.3" />
                </filter>
            </defs>
            <g filter="url(#muteShadow)">
                <!-- Speaker Horn Body -->
                <rect x="18" y="36" width="13" height="28" rx="2.5" fill="url(#speakerGrad)" stroke="#0369a1" stroke-width="1" />
                <path d="M 31 36 L 50 20 L 50 80 L 31 64 Z" fill="url(#speakerGrad)" stroke="#0369a1" stroke-width="1" />

                <!-- Acoustic Waves emitting from speaker -->
                <path d="M 58 35 C 64 42, 64 58, 58 65" fill="none" stroke="#0284c7" stroke-width="3" stroke-linecap="round" />
                <path d="M 66 28 C 76 39, 76 61, 66 72" fill="none" stroke="#0284c7" stroke-width="3" stroke-linecap="round" opacity="0.7" />

                <!-- Diagonal Mute Strike-Through Slash (Signature HMI Slash) -->
                <line x1="15" y1="82" x2="80" y2="18" stroke="#0284c7" stroke-width="5" stroke-linecap="round" />
                <line x1="16" y1="81" x2="79" y2="19" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round" />

                <!-- Digital Timer Display Box below with 7-Segment '00:00' Placeholder -->
                <rect x="23" y="68" width="54" height="20" rx="4" fill="#f8fafc" stroke="#94a3b8" stroke-width="1.2" opacity="0.9" />
                <!-- 7-Segment Style '00:00' Micro Glyphs -->
                <text x="50" y="83" font-family="'Courier New', monospace" font-size="12" font-weight="900" letter-spacing="2" fill="#64748b" text-anchor="middle">00:00</text>
            </g>
        </svg>