<svg viewBox="0 0 100 100" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <linearGradient id="clockFaceGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                    <stop offset="0%" stop-color="#ffffff" />
                    <stop offset="100%" stop-color="#f4f6f8" />
                </linearGradient>
                <filter id="clockShadow" x="-10%" y="-10%" width="120%" height="125%">
                    <feDropShadow dx="0" dy="2.5" stdDeviation="2.5" flood-color="#000000" flood-opacity="0.25" />
                </filter>
            </defs>
            <g filter="url(#clockShadow)">
                <!-- Clock Outer Blue Thin Ring -->
                <circle cx="50" cy="50" r="41" fill="url(#clockFaceGrad)" stroke="#1976d2" stroke-width="2.2" />
                
                <!-- Clock Hour Tick Marks (12, 3, 6, 9) -->
                <line x1="50" y1="13" x2="50" y2="17" stroke="#90a4ae" stroke-width="1.8" stroke-linecap="round" />
                <line x1="87" y1="50" x2="83" y2="50" stroke="#90a4ae" stroke-width="1.8" stroke-linecap="round" />
                <line x1="50" y1="87" x2="50" y2="83" stroke="#90a4ae" stroke-width="1.8" stroke-linecap="round" />
                <line x1="13" y1="50" x2="17" y2="50" stroke="#90a4ae" stroke-width="1.8" stroke-linecap="round" />

                <!-- Green Clock Hands (Positioned at ~ 10:10 / ~ 1:45 matching reference photo) -->
                <!-- Hour hand pointing up-left (~11:00) -->
                <line x1="50" y1="50" x2="40" y2="24" stroke="#4caf50" stroke-width="4.5" stroke-linecap="round" />
                
                <!-- Minute hand pointing up-right (~2:10) -->
                <line x1="50" y1="50" x2="73" y2="36" stroke="#4caf50" stroke-width="4.5" stroke-linecap="round" />

                <!-- Center Pivot Pin -->
                <circle cx="50" cy="50" r="4" fill="#388e3c" />
                <circle cx="50" cy="50" r="1.5" fill="#ffffff" />
            </g>
        </svg>