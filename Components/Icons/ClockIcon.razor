<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" width="120" height="120">
  <defs>
    <linearGradient id="esco_bg_time" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#071E3D"/>
      <stop offset="100%" stop-color="#020B18"/>
    </linearGradient>
    <filter id="time_glow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="0" stdDeviation="3" flood-color="#00E5FF" flood-opacity="0.4"/>
    </filter>
  </defs>
  <!-- ESCO Outer Bezel -->
  <rect x="2" y="2" width="116" height="116" rx="24" fill="url(#esco_bg_time)" stroke="#0E3A66" stroke-width="2"/>
  <rect x="5" y="5" width="110" height="110" rx="21" fill="none" stroke="#00D2FF" stroke-width="1" stroke-opacity="0.25"/>

  <!-- Clock Gauge Face -->
  <circle cx="60" cy="60" r="30" fill="#04142B" stroke="#00D2FF" stroke-width="2" filter="url(#time_glow)"/>

  <!-- Cardinal Tick Marks -->
  <line x1="60" y1="35" x2="60" y2="40" stroke="#00D2FF" stroke-width="2" stroke-linecap="round"/>
  <line x1="60" y1="80" x2="60" y2="85" stroke="#00D2FF" stroke-width="2" stroke-linecap="round"/>
  <line x1="35" y1="60" x2="40" y2="60" stroke="#00D2FF" stroke-width="2" stroke-linecap="round"/>
  <line x1="80" y1="60" x2="85" y2="60" stroke="#00D2FF" stroke-width="2" stroke-linecap="round"/>

  <!-- Emerald Green Hands matching ESCO time telemetry -->
  <line x1="60" y1="60" x2="48" y2="43" stroke="#10B981" stroke-width="4" stroke-linecap="round"/>
  <line x1="60" y1="60" x2="75" y2="46" stroke="#10B981" stroke-width="3.5" stroke-linecap="round"/>
  <circle cx="60" cy="60" r="3.2" fill="#00D2FF"/>
</svg>