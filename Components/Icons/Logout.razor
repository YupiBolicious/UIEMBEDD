<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" width="120" height="120">
  <defs>
    <linearGradient id="esco_bg_logout_time" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#071E3D"/>
      <stop offset="100%" stop-color="#020B18"/>
    </linearGradient>
    <linearGradient id="amberClockGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F59E0B"/>
      <stop offset="100%" stop-color="#EF4444"/>
    </linearGradient>
    <filter id="logout_time_glow" x="-25%" y="-25%" width="150%" height="150%">
      <feDropShadow dx="0" dy="0" stdDeviation="3.5" flood-color="#F59E0B" flood-opacity="0.5"/>
    </filter>
    <filter id="cyan_door_glow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="0" stdDeviation="2.5" flood-color="#00E5FF" flood-opacity="0.5"/>
    </filter>
  </defs>
  <!-- ESCO Outer Bezel -->
  <rect x="2" y="2" width="116" height="116" rx="24" fill="url(#esco_bg_logout_time)" stroke="#0E3A66" stroke-width="2"/>
  <rect x="5" y="5" width="110" height="110" rx="21" fill="none" stroke="#00D2FF" stroke-width="1" stroke-opacity="0.25"/>

  <!-- Clock Gauge Dial -->
  <circle cx="56" cy="60" r="28" fill="#04142B" stroke="#0E3A66" stroke-width="2.5"/>

  <!-- Clock tick indicators -->
  <line x1="56" y1="36" x2="56" y2="40" stroke="#00D2FF" stroke-width="2" stroke-linecap="round"/>
  <line x1="56" y1="80" x2="56" y2="84" stroke="#00D2FF" stroke-width="2" stroke-linecap="round"/>
  <line x1="32" y1="60" x2="36" y2="60" stroke="#00D2FF" stroke-width="2" stroke-linecap="round"/>

  <!-- Clock hands with timeout amber accent -->
  <g filter="url(#logout_time_glow)">
    <line x1="56" y1="60" x2="45" y2="48" stroke="#F59E0B" stroke-width="3.5" stroke-linecap="round"/>
    <line x1="56" y1="60" x2="70" y2="52" stroke="#F59E0B" stroke-width="3" stroke-linecap="round"/>
    <circle cx="56" cy="60" r="3" fill="#FDE047"/>
  </g>

  <!-- Logout Exit Door Portal & Arrow overlay on lower-right -->
  <g filter="url(#cyan_door_glow)" transform="translate(68, 54)">
    <!-- Door frame -->
    <path d="M12 4 L4 4 C2.5 4 1 5.5 1 7 L1 31 C1 32.5 2.5 34 4 34 L12 34" fill="none" stroke="#00D2FF" stroke-width="3" stroke-linecap="round"/>
    <!-- Exit Outflow Arrow -->
    <line x1="8" y1="19" x2="26" y2="19" stroke="#EF4444" stroke-width="3.5" stroke-linecap="round"/>
    <path d="M20 13 L26 19 L20 25" fill="none" stroke="#EF4444" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
  </g>
</svg>