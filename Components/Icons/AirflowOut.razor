  <path d="M32 33 L78 40 L78 80 L32 87 Z" fill="#04162C" stroke="#0E3A66" stroke-width="2"/>
  
  <!-- Louvre slats / grid markers -->
  <line x1="48" y1="36" x2="48" y2="84" stroke="#00D2FF" stroke-width="1.5" stroke-dasharray="3 3" stroke-opacity="0.8"/>
  <line x1="64" y1="38" x2="64" y2="82" stroke="#00D2FF" stroke-width="1.5" stroke-dasharray="3 3" stroke-opacity="0.8"/>
  <line x1="78" y1="40" x2="78" y2="80" stroke="#00D2FF" stroke-width="2.5"/>

