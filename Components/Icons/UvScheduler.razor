<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" width="120" height="120">
  <defs>
    <!-- ESCO Deep Navy Glass Background -->
    <linearGradient id="esco_bg_uv_combined" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#071E3D"/>
      <stop offset="100%" stop-color="#020B18"/>
    </linearGradient>

    <!-- Calendar Header Gradient (ESCO Cyan) -->
    <linearGradient id="calHeaderGradUv" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00E5FF"/>
      <stop offset="100%" stop-color="#0284C7"/>
    </linearGradient>

    <!-- UV Arc / Tube Neon Gradient -->
    <linearGradient id="uvTubeGradComb" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#C084FC"/>
      <stop offset="50%" stop-color="#00E5FF"/>
      <stop offset="100%" stop-color="#38BDF8"/>
    </linearGradient>

    <!-- Calendar & Chamber Glow -->
    <filter id="cal_comb_glow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="0" stdDeviation="3.5" flood-color="#00E5FF" flood-opacity="0.45"/>
    </filter>

    <!-- UV Core Lamp & Ray Glow -->
    <filter id="uv_core_glow" x="-25%" y="-25%" width="150%" height="150%">
      <feDropShadow dx="0" dy="0" stdDeviation="3.5" flood-color="#00E5FF" flood-opacity="0.7"/>
      <feDropShadow dx="0" dy="0" stdDeviation="5" flood-color="#A855F7" flood-opacity="0.4"/>
    </filter>

    <!-- UV Typography Capsule Glow -->
    <filter id="uv_badge_glow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="0" stdDeviation="2.5" flood-color="#00E5FF" flood-opacity="0.8"/>
    </filter>
  </defs>

  <!-- ESCO Outer Bezel -->
  <rect x="2" y="2" width="116" height="116" rx="24" fill="url(#esco_bg_uv_combined)" stroke="#0E3A66" stroke-width="2"/>
  <rect x="5" y="5" width="110" height="110" rx="21" fill="none" stroke="#00D2FF" stroke-width="1" stroke-opacity="0.25"/>

  <!-- Calendar Schedule Chassis from UV Scheduler -->
  <g filter="url(#cal_comb_glow)">
    <!-- Calendar Base Card -->
    <rect x="20" y="24" width="80" height="72" rx="10" fill="#04162C" stroke="#00D2FF" stroke-width="1.8"/>

    <!-- Calendar Header Banner -->
    <path d="M 20 34 C 20 28.5 24.5 24 30 24 L 90 24 C 95.5 24 100 28.5 100 34 L 100 41 L 20 41 Z" fill="url(#calHeaderGradUv)"/>

    <!-- Top Binder Loops / Pegs -->
    <rect x="32" y="19" width="4.5" height="9" rx="2" fill="#E0F2FE"/>
    <rect x="58" y="19" width="4.5" height="9" rx="2" fill="#E0F2FE"/>
    <rect x="84" y="19" width="4.5" height="9" rx="2" fill="#E0F2FE"/>

    <!-- Central Dial Circular Chamber -->
    <circle cx="60" cy="67" r="23" fill="#020B18" stroke="#0E3A66" stroke-width="2"/>
    <circle cx="60" cy="67" r="23" fill="none" stroke="#00D2FF" stroke-width="1.2" stroke-dasharray="3.5 2" opacity="0.75"/>
  </g>

  <!-- UV Germicidal Quartz Lamp & Radiant Rays from UV Icon -->
  <g filter="url(#uv_core_glow)">
    <!-- Radiating Germicidal Beams -->
    <line x1="60" y1="46" x2="60" y2="42" stroke="#C084FC" stroke-width="1.8" stroke-linecap="round"/>
    <line x1="75" y1="52" x2="78" y2="49" stroke="#00E5FF" stroke-width="1.8" stroke-linecap="round"/>
    <line x1="45" y1="52" x2="42" y2="49" stroke="#00E5FF" stroke-width="1.8" stroke-linecap="round"/>
    <line x1="81" y1="67" x2="85" y2="67" stroke="#C084FC" stroke-width="1.8" stroke-linecap="round"/>
    <line x1="39" y1="67" x2="35" y2="67" stroke="#C084FC" stroke-width="1.8" stroke-linecap="round"/>

    <!-- Germicidal Quartz Tube Bulb Body -->
    <rect x="52" y="49" width="16" height="26" rx="5" fill="#030E1D" stroke="#00E5FF" stroke-width="1.5"/>
    
    <!-- UVC Dual Arc Violet/Cyan Filament -->
    <path d="M 57 71 L 57 56 C 57 53 63 53 63 56 L 63 71" fill="none" stroke="url(#uvTubeGradComb)" stroke-width="2.4" stroke-linecap="round"/>
    
    <!-- Lamp Terminal Base Cap -->
    <rect x="54" y="75" width="12" height="3" rx="1" fill="#38BDF8"/>
  </g>

  <!-- High-Fidelity UV Typography Badge Pill at bottom of dial -->
  <g filter="url(#uv_badge_glow)">
    <rect x="44" y="78" width="32" height="15" rx="4.5" fill="#041830" stroke="#00E5FF" stroke-width="1.5"/>
    <text x="60" y="89.5" font-family="system-ui, -apple-system, sans-serif" font-size="10.5" font-weight="900" fill="#00E5FF" letter-spacing="1.5" text-anchor="middle">UV</text>
  </g>
</svg>