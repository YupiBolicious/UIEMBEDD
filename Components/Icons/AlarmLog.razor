<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" width="120" height="120">
  <defs>
    <!-- ESCO Deep Navy Glass Background -->
    <linearGradient id="bg_alarm_clean" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#071E3D"/>
      <stop offset="100%" stop-color="#020B18"/>
    </linearGradient>

    <!-- Industrial Dark Glass Bell Gradient (Subtle crimson accent, predominantly deep navy) -->
    <linearGradient id="bellGlassGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0A2C54"/>
      <stop offset="60%" stop-color="#041830"/>
      <stop offset="100%" stop-color="#020D1C"/>
    </linearGradient>

    <!-- Refined Minimal Warning Amber/Red Badge Gradient -->
    <linearGradient id="alarmBadgeGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F87171"/>
      <stop offset="100%" stop-color="#DC2626"/>
    </linearGradient>

    <!-- Subtle Cyan Frame Glow -->
    <filter id="alarm_cyan_glow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="0" stdDeviation="3.5" flood-color="#00E5FF" flood-opacity="0.45"/>
    </filter>

    <!-- Discreet Acoustic / Accent Glow -->
    <filter id="acoustic_glow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="0" stdDeviation="2" flood-color="#F87171" flood-opacity="0.5"/>
    </filter>
  </defs>

  <!-- ESCO Standard Squircle Bezel (120x120, rx=24) -->
  <rect x="2" y="2" width="116" height="116" rx="24" fill="url(#bg_alarm_clean)" stroke="#0E3A66" stroke-width="2"/>
  <rect x="5" y="5" width="110" height="110" rx="21" fill="none" stroke="#00D2FF" stroke-width="1" stroke-opacity="0.25"/>

  <!-- Simplified Precision Bell Silhouette on Glass Chassis -->
  <g filter="url(#alarm_cyan_glow)">
    <!-- Dial / Acoustic Boundary Ring -->
    <circle cx="60" cy="54" r="32" fill="#031326" stroke="#0E3A66" stroke-width="1.8"/>
    <circle cx="60" cy="54" r="32" fill="none" stroke="#00D2FF" stroke-width="1.2" stroke-opacity="0.4" stroke-dasharray="3 3"/>

    <!-- Bell Top Ring Mount / Hanger -->
    <path d="M 58 29 C 58 26.5 62 26.5 62 29" fill="none" stroke="#00E5FF" stroke-width="2" stroke-linecap="round"/>

    <!-- Minimalist Industrial Bell Body (Deep navy glass with crisp cyan contour) -->
    <path d="M 50 42 C 50 35 54.5 31 60 31 C 65.5 31 70 35 70 42 L 70 56 C 73.5 59 75 62 75 64 L 45 64 C 45 62 46.5 59 50 56 Z" fill="url(#bellGlassGrad)" stroke="#00E5FF" stroke-width="1.8" stroke-linejoin="round"/>

    <!-- Subtle Bell Rim Highlight Line -->
    <line x1="48" y1="63.5" x2="72" y2="63.5" stroke="#38BDF8" stroke-width="1.5" stroke-linecap="round"/>

    <!-- Bell Clapper Bead (Clean white with subtle warm halo) -->
    <circle cx="60" cy="68" r="3.2" fill="#FFFFFF" stroke="#04162C" stroke-width="1.2"/>
  </g>

  <!-- Clean, Simplified Acoustic Waves (Left & Right - Minimal, restrained red/amber accents) -->
  <g filter="url(#acoustic_glow)">
    <!-- Left Waves -->
    <path d="M 40 46 C 37 50 37 56 40 60" fill="none" stroke="#F87171" stroke-width="1.8" stroke-linecap="round" opacity="0.85"/>
    <path d="M 34 49 C 32 52 32 55 34 57" fill="none" stroke="#00E5FF" stroke-width="1.2" stroke-linecap="round" opacity="0.6"/>

    <!-- Right Waves -->
    <path d="M 80 46 C 83 50 83 56 80 60" fill="none" stroke="#F87171" stroke-width="1.8" stroke-linecap="round" opacity="0.85"/>
    <path d="M 86 49 C 88 52 88 55 86 57" fill="none" stroke="#00E5FF" stroke-width="1.2" stroke-linecap="round" opacity="0.6"/>

    <!-- Discrete Warning Indicator Pip at Bell Top Core -->
    <circle cx="60" cy="39" r="2.2" fill="#F87171"/>
  </g>

  <!-- Simplified Minimal Status Capsule (Bottom - Cyan Frame with Crisp Red Telemetry Text) -->
  <g filter="url(#alarm_cyan_glow)">
    <rect x="36" y="87" width="48" height="15" rx="4.5" fill="#020E1E" stroke="#00D2FF" stroke-width="1.4"/>
    <text x="60" y="98" font-family="system-ui, -apple-system, sans-serif" font-size="6" font-weight="800" fill="#F87171" letter-spacing="1.5" text-anchor="middle">ALARMLOG</text>
  </g>
</svg>