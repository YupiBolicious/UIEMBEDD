<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" width="120" height="120">
  <defs>
    <linearGradient id="esco_bg_net" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#071E3D"/>
      <stop offset="100%" stop-color="#020B18"/>
    </linearGradient>
    <linearGradient id="esco_wifi" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00E5FF"/>
      <stop offset="100%" stop-color="#0284C7"/>
    </linearGradient>
    <filter id="wifi_glow" x="-25%" y="-25%" width="150%" height="150%">
      <feDropShadow dx="0" dy="0" stdDeviation="3.5" flood-color="#00E5FF" flood-opacity="0.6"/>
    </filter>
  </defs>
  <!-- ESCO Outer Bezel -->
  <rect x="2" y="2" width="116" height="116" rx="24" fill="url(#esco_bg_net)" stroke="#0E3A66" stroke-width="2"/>
  <rect x="5" y="5" width="110" height="110" rx="21" fill="none" stroke="#00D2FF" stroke-width="1" stroke-opacity="0.25"/>

  <!-- Radiating Wi-Fi / Remote Modbus Network Wave Arcs -->
  <g filter="url(#wifi_glow)">
    <!-- Outer wave arc -->
    <path d="M34 44 A 36 36 0 0 1 86 44" fill="none" stroke="url(#esco_wifi)" stroke-width="5" stroke-linecap="round"/>
    <!-- Middle wave arc -->
    <path d="M43 56 A 24 24 0 0 1 77 56" fill="none" stroke="url(#esco_wifi)" stroke-width="5" stroke-linecap="round"/>
    <!-- Inner wave arc -->
    <path d="M52 68 A 12 12 0 0 1 68 68" fill="none" stroke="url(#esco_wifi)" stroke-width="5" stroke-linecap="round"/>
    <!-- Center broadcast transceiver node -->
    <circle cx="60" cy="80" r="4" fill="#00E5FF"/>
  </g>
</svg>