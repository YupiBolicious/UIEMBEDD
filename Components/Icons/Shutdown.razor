<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" width="120" height="120">
  <defs>
    <!-- ESCO Tile Background: Deep Navy Glass Gradient matching other icons in grid -->
    <linearGradient id="esco_sd_bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#071E3D"/>
      <stop offset="100%" stop-color="#020B18"/>  
    </linearGradient>

    <!-- Inner dark recessed plate -->
    <linearGradient id="esco_sd_plate" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#061830"/>
      <stop offset="100%" stop-color="#020C1A"/>
    </linearGradient>

    <!-- Vibrant Red Glowing Power Stroke Gradient -->
    <linearGradient id="red_power_stroke" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#FF5252"/>
      <stop offset="100%" stop-color="#EF4444"/>
    </linearGradient>

    <!-- Crimson Outer Glow Filter -->
    <filter id="crimson_glow" x="-30%" y="-30%" width="160%" height="160%">
      <feDropShadow dx="0" dy="0" stdDeviation="3.5" flood-color="#EF4444" flood-opacity="0.8"/>
      <feDropShadow dx="0" dy="0" stdDeviation="1" flood-color="#FF7878" flood-opacity="0.9"/>
    </filter>

    <!-- Subtle Cyan Bezel Glow -->
    <filter id="tile_cyan_glow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="0" stdDeviation="2.5" flood-color="#00E5FF" flood-opacity="0.35"/>
    </filter>
  </defs>

  <!-- ESCO Standard Squircle Bezel (120x120, rx=24) matching all other menu tiles -->
  <rect x="2" y="2" width="116" height="116" rx="24" fill="url(#esco_sd_bg)" stroke="#0E3A66" stroke-width="2"/>
  <rect x="5" y="5" width="110" height="110" rx="21" fill="none" stroke="#00D2FF" stroke-width="1" stroke-opacity="0.35"/>


  <!-- Subtle Concentric Guide Ring in deep cyan, matching Time and TimeZone icons -->
  <circle cx="60" cy="60" r="32" fill="none" stroke="#0E3A66" stroke-width="1" stroke-dasharray="3 3" opacity="0.6"/>

  <!-- Crimson Power Glyph - Perfectly styled as neon line art matching the rest of the ESCO suite -->
  <g filter="url(#crimson_glow)">
    <!-- Open Circular Power Arc -->
    <!-- Arc centered at (60, 62) with radius 21, leaving top open between angles ~ -55 deg and +55 deg -->
    <path d="M 45.5 44.8 A 21 21 0 1 0 74.5 44.8" 
          fill="none" 
          stroke="url(#red_power_stroke)" 
          stroke-width="5" 
          stroke-linecap="round"/>

      <!-- Central Vertical Power Stile (Pure crisp white) -->
    <line x1="60" y1="45" x2="60" y2="60" 
          stroke="#FFFFFF" 
          stroke-width="5" 
          stroke-linecap="round"/>
  </g>

  <!-- Ambient red soft floor glow inside the tile -->
  <ellipse cx="60" cy="65" rx="14" ry="14" fill="#EF4444" fill-opacity="0.1" filter="blur(6px)"/>
</svg>