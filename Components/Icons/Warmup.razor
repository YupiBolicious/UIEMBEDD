<svg viewBox="0 0 100 100" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <linearGradient id="greenArrowGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#4ade80" />
                    <stop offset="60%" stop-color="#22c55e" />
                    <stop offset="100%" stop-color="#15803d" />
                </linearGradient>
                <filter id="warmShadow" x="-20%" y="-20%" width="140%" height="140%">
                    <feDropShadow dx="0" dy="3" stdDeviation="2.5" flood-color="#15803d" flood-opacity="0.25" />
                </filter>
            </defs>

            <g filter="url(#warmShadow)">
                <!-- Esco Cabinet Outline Housing -->
                <rect x="20" y="19" width="60" height="62" rx="4" fill="#ffffff" stroke="#94a3b8" stroke-width="1.8" />
                <!-- Blue Upper Sash / Air Plenum Band -->
                <rect x="21" y="38" width="58" height="11" fill="#0284c7" />
                
                <!-- Circular Green Warmup Arrow Arc -->
                <g transform="translate(50, 56)">
                    <!-- Segmented progress tick marks along circular arc -->
                    <path d="M 0 -17 A 17 17 0 1 1 -15 7" fill="none" stroke="url(#greenArrowGrad)" stroke-width="5.5" stroke-linecap="round" />
                    
                    <!-- Arrowhead at top-left pointing clockwise -->
                    <polygon points="-5,-23 5,-17 -3,-12" fill="#16a34a" />

                    <!-- Segment divisions for progress feel -->
                    <circle cx="15" cy="-7" r="1.5" fill="#ffffff" />
                    <circle cx="16" cy="6" r="1.5" fill="#ffffff" />
                    <circle cx="9" cy="14" r="1.5" fill="#ffffff" />
                    <circle cx="-5" cy="16" r="1.5" fill="#ffffff" />
                </g>
            </g>
        </svg>