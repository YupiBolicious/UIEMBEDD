<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" width="120" height="120">
  <defs>
    <!-- ESCO Deep Navy Glass Background -->
    <linearGradient id="esco_bg_about" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#071E3D"/>
      <stop offset="100%" stop-color="#020B18"/>
    </linearGradient>

    <!-- Information Bubble Gradient -->
    <linearGradient id="aboutBubbleGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00E5FF"/>
      <stop offset="50%" stop-color="#0284C7"/>
      <stop offset="100%" stop-color="#0369A1"/>
    </linearGradient>

    <filter id="about_bubble_glow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="0" stdDeviation="4" flood-color="#00E5FF" flood-opacity="0.55"/>
    </filter>

    <filter id="info_i_glow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="0" stdDeviation="2.5" flood-color="#FFFFFF" flood-opacity="0.7"/>
    </filter>
  </defs>

  <!-- ESCO Outer Bezel -->
  <rect x="2" y="2" width="116" height="116" rx="24" fill="url(#esco_bg_about)" stroke="#0E3A66" stroke-width="2"/>
  <rect x="5" y="5" width="110" height="110" rx="21" fill="none" stroke="#00D2FF" stroke-width="1" stroke-opacity="0.25"/>

  <!-- Info Speech Bubble Frame -->
  <g filter="url(#about_bubble_glow)">
    <path d="M 28 36 C 28 29.5 33.5 24 40 24 L 80 24 C 86.5 24 92 29.5 92 36 L 92 72 C 92 78.5 86.5 84 80 84 L 46 84 L 30 96 L 33 84 C 30 81.5 28 77 28 72 Z" fill="url(#aboutBubbleGrad)" stroke="#00E5FF" stroke-width="2"/>
    
    <!-- Subtle Inner Border Highlight -->
    <path d="M 31 37 C 31 32 35 27.5 40 27.5 L 80 27.5 C 85 27.5 89 32 89 37 L 89 71 C 89 76 85 80.5 80 80.5 L 45 80.5 L 34 89 L 36 81 C 33 79 31 75 31 71 Z" fill="none" stroke="#E0F2FE" stroke-width="0.8" opacity="0.4"/>
  </g>

  <!-- Centered Info "i" Glyph -->
  <g filter="url(#info_i_glow)">
    <!-- Top Dot -->
    <circle cx="60" cy="42" r="5" fill="#FFFFFF"/>
    <!-- Lower Stem -->
    <rect x="56" y="51" width="8" height="23" rx="4" fill="#FFFFFF"/>
  </g>
</svg>