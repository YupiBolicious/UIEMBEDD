<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" width="120" height="120">
  <defs>
    <!-- ESCO Deep Navy Glass Background -->
    <linearGradient id="esco_bg_clock_clean" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#071E3D"/>
      <stop offset="100%" stop-color="#020B18"/>
    </linearGradient>

    <!-- Dial Ring Gradient -->
    <linearGradient id="clockDialGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00E5FF"/>
      <stop offset="100%" stop-color="#0284C7"/>
    </linearGradient>

    <!-- Precision Telemetry Emerald Green Hand Gradient -->
    <linearGradient id="emeraldClockGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#34D399"/>
      <stop offset="100%" stop-color="#10B981"/>
    </linearGradient>

    <!-- Ambient Neon Glow -->
    <filter id="clock_neon_glow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="0" stdDeviation="3.5" flood-color="#00E5FF" flood-opacity="0.5"/>
    </filter>

    <filter id="hand_emerald_glow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="0" stdDeviation="2.5" flood-color="#10B981" flood-opacity="0.7"/>
    </filter>
  </defs>

  <!-- ESCO Outer Bezel -->
  <rect x="2" y="2" width="116" height="116" rx="24" fill="url(#esco_bg_clock_clean)" stroke="#0E3A66" stroke-width="2"/>
  <rect x="5" y="5" width="110" height="110" rx="21" fill="none" stroke="#00D2FF" stroke-width="1" stroke-opacity="0.25"/>

  <!-- Instrument Dial Gauge Frame -->
  <g filter="url(#clock_neon_glow)">
    <!-- Outer Track Dial Ring -->
    <circle cx="60" cy="60" r="34" fill="#04162C" stroke="#0E3A66" stroke-width="2.5"/>
    <circle cx="60" cy="60" r="34" fill="none" stroke="#00D2FF" stroke-width="1.8"/>

    <!-- Subtle Inset Gauge Scale -->
    <circle cx="60" cy="60" r="28" fill="#020B18" stroke="#00D2FF" stroke-width="1" stroke-opacity="0.3" stroke-dasharray="2 2"/>

    <!-- 12-Hour Calibration Hour Ticks -->
    <!-- 12, 3, 6, 9 (Major Cardinal Ticks) -->
    <line x1="60" y1="31" x2="60" y2="38" stroke="#00E5FF" stroke-width="2.8" stroke-linecap="round"/>
    <line x1="89" y1="60" x2="82" y2="60" stroke="#00E5FF" stroke-width="2.8" stroke-linecap="round"/>
    <line x1="60" y1="89" x2="60" y2="82" stroke="#00E5FF" stroke-width="2.8" stroke-linecap="round"/>
    <line x1="31" y1="60" x2="38" y2="60" stroke="#00E5FF" stroke-width="2.8" stroke-linecap="round"/>

    <!-- Minor Hour Pips (1, 2, 4, 5, 7, 8, 10, 11) -->
    <circle cx="74" cy="36" r="1.5" fill="#38BDF8"/>
    <circle cx="84" cy="46" r="1.5" fill="#38BDF8"/>
    <circle cx="84" cy="74" r="1.5" fill="#38BDF8"/>
    <circle cx="74" cy="84" r="1.5" fill="#38BDF8"/>
    <circle cx="46" cy="84" r="1.5" fill="#38BDF8"/>
    <circle cx="36" cy="74" r="1.5" fill="#38BDF8"/>
    <circle cx="36" cy="46" r="1.5" fill="#38BDF8"/>
    <circle cx="46" cy="36" r="1.5" fill="#38BDF8"/>
  </g>

  <!-- Precision Clock Hands (Hour, Minute & Active Seconds Needle) -->
  <g filter="url(#hand_emerald_glow)">
    <!-- Hour Hand pointing to ~10:10 (Industrial standard display) -->
    <line x1="60" y1="60" x2="45" y2="42" stroke="url(#emeraldClockGrad)" stroke-width="4.5" stroke-linecap="round"/>
    
    <!-- Minute Hand pointing to ~2 o'clock -->
    <line x1="60" y1="60" x2="78" y2="45" stroke="url(#emeraldClockGrad)" stroke-width="3.2" stroke-linecap="round"/>

    <!-- Central Precision Bezel Pivot Hub -->
    <circle cx="60" cy="60" r="4.5" fill="#04162C" stroke="#00E5FF" stroke-width="1.8"/>
    <circle cx="60" cy="60" r="2.2" fill="#FFFFFF"/>
    
    <!-- Fine Sweep Seconds Indicator (Amber accent tail) -->
    <line x1="60" y1="60" x2="60" y2="78" stroke="#F59E0B" stroke-width="1.4" stroke-linecap="round"/>
    <circle cx="60" cy="78" r="1.5" fill="#F59E0B"/>
  </g>
</svg>