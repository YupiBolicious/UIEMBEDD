 <svg viewBox="0 0 100 100" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <linearGradient id="switchPlateGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                    <stop offset="0%" stop-color="#e2e8f0" />
                    <stop offset="100%" stop-color="#cbd5e1" />
                </linearGradient>
                <linearGradient id="handleBarGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                    <stop offset="0%" stop-color="#38bdf8" />
                    <stop offset="50%" stop-color="#0284c7" />
                    <stop offset="100%" stop-color="#0369a1" />
                </linearGradient>
                <linearGradient id="metalContactGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="#94a3b8" />
                    <stop offset="50%" stop-color="#f8fafc" />
                    <stop offset="100%" stop-color="#64748b" />
                </linearGradient>
                <filter id="switchShadow" x="-20%" y="-20%" width="140%" height="140%">
                    <feDropShadow dx="0" dy="3" stdDeviation="2.5" flood-color="#0f172a" flood-opacity="0.25" />
                </filter>
            </defs>

            <g filter="url(#switchShadow)">
                <!-- Metal Mounting Baseplate with Screws -->
                <rect x="16" y="24" width="56" height="52" rx="6" fill="url(#switchPlateGrad)" stroke="#94a3b8" stroke-width="1.5" />
                <!-- 4 Corner Mounting Screws -->
                <circle cx="21" cy="29" r="2.2" fill="#64748b" />
                <circle cx="67" cy="29" r="2.2" fill="#64748b" />
                <circle cx="21" cy="71" r="2.2" fill="#64748b" />
                <circle cx="67" cy="71" r="2.2" fill="#64748b" />

                <!-- Recessed Switch Well -->
                <rect x="25" y="37" width="38" height="26" rx="5" fill="#334155" stroke="#1e293b" stroke-width="1.5" />

                <!-- Chrome Switch Contacts / Lever Arm -->
                <rect x="30" y="44" width="28" height="12" rx="3" fill="url(#metalContactGrad)" stroke="#475569" stroke-width="1" />
                
                <!-- Horizontal Actuator Bar reaching to Right Handle -->
                <path d="M 44 48 L 74 48" stroke="#64748b" stroke-width="6" stroke-linecap="round" />
                <path d="M 44 52 L 74 52" stroke="#cbd5e1" stroke-width="3" stroke-linecap="round" />

                <!-- Right Vertical Grip Handle (Cyan/Blue Ergonomic Grip) -->
                <rect x="74" y="28" width="10" height="44" rx="4" fill="url(#handleBarGrad)" stroke="#0369a1" stroke-width="1.5" />
                <!-- Grip Rings -->
                <line x1="74" y1="38" x2="84" y2="38" stroke="#ffffff" stroke-width="1.5" opacity="0.7" />
                <line x1="74" y1="50" x2="84" y2="50" stroke="#ffffff" stroke-width="1.5" opacity="0.7" />
                <line x1="74" y1="62" x2="84" y2="62" stroke="#ffffff" stroke-width="1.5" opacity="0.7" />
            </g>
        </svg>