<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" width="120" height="120">
  <defs>
    <linearGradient id="esco_bg_tz" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#071E3D"/>
      <stop offset="100%" stop-color="#020B18"/>
    </linearGradient>
    <linearGradient id="pinGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#34D399"/>
      <stop offset="100%" stop-color="#10B981"/>
    </linearGradient>
    <filter id="tz_glow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="0" stdDeviation="3.5" flood-color="#10B981" flood-opacity="0.55"/>
    </filter>
  </defs>
  <!-- ESCO Outer Bezel -->
  <rect x="2" y="2" width="116" height="116" rx="24" fill="url(#esco_bg_tz)" stroke="#0E3A66" stroke-width="2"/>
  <rect x="5" y="5" width="110" height="110" rx="21" fill="none" stroke="#00D2FF" stroke-width="1" stroke-opacity="0.25"/>

  <!-- Globe / Meridian Grid -->
  <circle cx="60" cy="60" r="30" fill="#04142B" stroke="#0E3A66" stroke-width="2"/>
  <!-- Longitude meridian & Latitude lines -->
  <ellipse cx="60" cy="60" rx="14" ry="30" fill="none" stroke="#00D2FF" stroke-width="1.5" stroke-opacity="0.6"/>
  <line x1="30" y1="60" x2="90" y2="60" stroke="#00D2FF" stroke-width="1.8" stroke-dasharray="3 2" stroke-opacity="0.8"/>
  <line x1="60" y1="30" x2="60" y2="90" stroke="#00D2FF" stroke-width="1.2" stroke-opacity="0.4"/>
  <line x1="35" y1="46" x2="85" y2="46" stroke="#0E3A66" stroke-width="1.2"/>
  <line x1="35" y1="74" x2="85" y2="74" stroke="#0E3A66" stroke-width="1.2"/>

  <!-- Emerald Green Map Location Pin -->
  <g filter="url(#tz_glow)">
    <!-- Pin body centered at (60, 56) with point resting at (60, 69) -->
    <path d="M60 41 C53 41 47 47 47 54 C47 64 60 76 60 76 C60 76 73 64 73 54 C73 47 67 41 60 41 Z" fill="url(#pinGrad)"/>
    <!-- Center white eyelet / beacon node -->
    <circle cx="60" cy="53" r="4" fill="#FFFFFF"/>
  </g>
</svg>