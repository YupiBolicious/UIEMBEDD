 <svg class="@Class" width="@Width" height="@Height" viewBox="0 0 50 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <defs>
                                        <linearGradient id="glassStemGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                                            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.8" />
                                            <stop offset="30%" stop-color="#bae6fd" stop-opacity="0.4" />
                                            <stop offset="100%" stop-color="#0284c7" stop-opacity="0.7" />
                                        </linearGradient>
                                        <linearGradient id="fluidOrangeGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                                            <stop offset="0%" stop-color="#f97316" />
                                            <stop offset="50%" stop-color="#fb923c" />
                                            <stop offset="100%" stop-color="#ea580c" />
                                        </linearGradient>
                                        <radialGradient id="bulbRadialGrad" cx="35%" cy="35%" r="65%">
                                            <stop offset="0%" stop-color="#fed7aa" />
                                            <stop offset="40%" stop-color="#fb923c" />
                                            <stop offset="100%" stop-color="#c2410c" />
                                        </radialGradient>
                                        <filter id="fluidGlow" x="-20%" y="-20%" width="140%" height="140%">
                                            <feDropShadow dx="0" dy="0" stdDeviation="2.5" flood-color="#f97316" flood-opacity="0.5" />
                                        </filter>
                                    </defs>

                                    <!-- Thermometer Outer Glass Tube & Bulb Silhouette -->
                                    <path d="M 18 16 C 18 10, 32 10, 32 16 L 32 62 C 38 65, 42 72, 42 79 C 42 88, 34 96, 25 96 C 16 96, 8 88, 8 79 C 8 72, 12 65, 18 62 Z" 
                                          fill="url(#glassStemGrad)" stroke="#38bdf8" stroke-width="2.5" stroke-linejoin="round" />

                                    <!-- Inner Glass Highlight Reflection -->
                                    <path d="M 20 18 L 20 62 C 16 65, 12 71, 12 79 C 12 84, 15 89, 19 92" stroke="#ffffff" stroke-width="1.5" stroke-linecap="round" opacity="0.6" />

                                    <!-- Liquid Thermometer Column -->
                                    <g filter="url(#fluidGlow)">
                                        <!-- Fluid Stem (showing elevated 28°C level) -->
                                        <rect x="22" y="34" width="6" height="34" rx="1.5" fill="url(#fluidOrangeGrad)" />
                                        <!-- Fluid Bulb Reservoir -->
                                        <circle cx="25" cy="79" r="11" fill="url(#bulbRadialGrad)" />
                                        <circle cx="21" cy="75" r="3" fill="#ffffff" opacity="0.75" />
                                    </g>

                                    <!-- Temperature Calibration Graduation Ticks -->
                                    <line x1="32" y1="26" x2="38" y2="26" stroke="#bae6fd" stroke-width="2" stroke-linecap="round" />
                                    <line x1="32" y1="36" x2="38" y2="36" stroke="#bae6fd" stroke-width="2" stroke-linecap="round" />
                                    <line x1="32" y1="46" x2="38" y2="46" stroke="#bae6fd" stroke-width="2" stroke-linecap="round" />
                                    <line x1="32" y1="56" x2="38" y2="56" stroke="#bae6fd" stroke-width="2" stroke-linecap="round" />
                                </svg>
@code {
    [Parameter] public string Width { get; set; } = "100%";
    [Parameter] public string Height { get; set; } = "100%";
    [Parameter] public string? Class { get; set; }
    public Dictionary<string, object>? AdditionalAttributes { get; set; }
}