<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" width="120" height="120">
  <defs>
    <!-- ESCO Deep Navy Glass Background -->
    <linearGradient id="esco_bg_ls" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#071E3D"/>
      <stop offset="100%" stop-color="#020B18"/>
    </linearGradient>

    <!-- Calendar Header Gradient (ESCO Cyan) -->
    <linearGradient id="lsHeaderGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00E5FF"/>
      <stop offset="100%" stop-color="#0284C7"/>
    </linearGradient>

    <!-- Luminous Filament / Bulb Gradient (Amber/Yellow) -->
    <linearGradient id="bulbAmberGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FDE047"/>
      <stop offset="100%" stop-color="#F59E0B"/>
    </linearGradient>

    <filter id="ls_cal_glow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="0" stdDeviation="3.5" flood-color="#00E5FF" flood-opacity="0.45"/>
    </filter>

    <filter id="bulb_glow" x="-25%" y="-25%" width="150%" height="150%">
      <feDropShadow dx="0" dy="0" stdDeviation="3.5" flood-color="#FDE047" flood-opacity="0.6"/>
    </filter>
  </defs>

  <!-- ESCO Outer Bezel -->
  <rect x="2" y="2" width="116" height="116" rx="24" fill="url(#esco_bg_ls)" stroke="#0E3A66" stroke-width="2"/>
  <rect x="5" y="5" width="110" height="110" rx="21" fill="none" stroke="#00D2FF" stroke-width="1" stroke-opacity="0.25"/>

  <!-- Calendar Schedule Chassis -->
  <g filter="url(#ls_cal_glow)">
    <!-- Calendar Card Base -->
    <rect x="22" y="27" width="76" height="66" rx="10" fill="#04162C" stroke="#00D2FF" stroke-width="1.8"/>

    <!-- Calendar Header Banner -->
    <path d="M 22 37 C 22 31.5 26.5 27 32 27 L 88 27 C 93.5 27 98 31.5 98 37 L 98 44 L 22 44 Z" fill="url(#lsHeaderGrad)"/>

    <!-- Binder Loops / Pegs -->
    <rect x="34" y="22" width="4.5" height="9" rx="2" fill="#E0F2FE"/>
    <rect x="58" y="22" width="4.5" height="9" rx="2" fill="#E0F2FE"/>
    <rect x="82" y="22" width="4.5" height="9" rx="2" fill="#E0F2FE"/>

    <!-- Central Dial Circular Ring -->
    <circle cx="60" cy="67" r="18" fill="#020B18" stroke="#0E3A66" stroke-width="2"/>
    <circle cx="60" cy="67" r="18" fill="none" stroke="#00D2FF" stroke-width="1.2" stroke-dasharray="3 2" opacity="0.6"/>
  </g>

  <!-- Luminous Light Bulb with Radiant Rays -->
  <g filter="url(#bulb_glow)">
    <!-- Radiating Light Rays -->
    <line x1="60" y1="48" x2="60" y2="45" stroke="#FDE047" stroke-width="1.8" stroke-linecap="round"/>
    <line x1="72" y1="52" x2="75" y2="50" stroke="#FDE047" stroke-width="1.8" stroke-linecap="round"/>
    <line x1="48" y1="52" x2="45" y2="50" stroke="#FDE047" stroke-width="1.8" stroke-linecap="round"/>
    <line x1="76" y1="64" x2="79" y2="64" stroke="#FDE047" stroke-width="1.8" stroke-linecap="round"/>
    <line x1="44" y1="64" x2="41" y2="64" stroke="#FDE047" stroke-width="1.8" stroke-linecap="round"/>

    <!-- Bulb Body -->
    <path d="M 55 72 L 65 72 L 66 68 C 69 65 70 61 70 58 C 70 52.5 65.5 48 60 48 C 54.5 48 50 52.5 50 58 C 50 61 51 65 54 68 Z" fill="url(#bulbAmberGrad)" stroke="#FFE082" stroke-width="0.8"/>
    
    <!-- Bulb Base / Screw Thread & Contact -->
    <rect x="56" y="73" width="8" height="2" rx="0.5" fill="#94A3B8"/>
    <rect x="57" y="76" width="6" height="1.8" rx="0.5" fill="#64748B"/>
    <path d="M 58 78 L 62 78 L 61 80 L 59 80 Z" fill="#38BDF8"/>

    <!-- Inner Core Glow -->
    <circle cx="60" cy="57" r="3" fill="#FFFFFF"/>
  </g>
</svg>