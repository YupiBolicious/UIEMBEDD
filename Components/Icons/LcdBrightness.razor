<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" width="120" height="120">
  <defs>
    <!-- ESCO Deep Navy Glass Background -->
    <linearGradient id="bg_lcd_bright" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#071E3D"/>
      <stop offset="100%" stop-color="#020B18"/>
    </linearGradient>

    <!-- Screen Glass Gradient -->
    <linearGradient id="screenGlass" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#06284F"/>
      <stop offset="100%" stop-color="#021024"/>
    </linearGradient>

    <!-- Radiant Sun / Brightness Beam Gradient -->
    <linearGradient id="brightSunGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00E5FF"/>
      <stop offset="50%" stop-color="#38BDF8"/>
      <stop offset="100%" stop-color="#FDE047"/>
    </linearGradient>

    <filter id="monitor_glow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="0" stdDeviation="3.5" flood-color="#00E5FF" flood-opacity="0.5"/>
    </filter>

    <filter id="sun_glow" x="-25%" y="-25%" width="150%" height="150%">
      <feDropShadow dx="0" dy="0" stdDeviation="3.5" flood-color="#00E5FF" flood-opacity="0.8"/>
      <feDropShadow dx="0" dy="0" stdDeviation="6" flood-color="#FDE047" flood-opacity="0.4"/>
    </filter>
  </defs>

  <!-- ESCO Outer Bezel -->
  <rect x="2" y="2" width="116" height="116" rx="24" fill="url(#bg_lcd_bright)" stroke="#0E3A66" stroke-width="2"/>
  <rect x="5" y="5" width="110" height="110" rx="21" fill="none" stroke="#00D2FF" stroke-width="1" stroke-opacity="0.25"/>

  <!-- LCD Screen / Monitor Chassis -->
  <g filter="url(#monitor_glow)">
    <!-- Monitor Outer Display Frame -->
    <rect x="22" y="23" width="76" height="52" rx="8" fill="#04162C" stroke="#00D2FF" stroke-width="1.8"/>

    <!-- Inner Active LCD Panel -->
    <rect x="26" y="27" width="68" height="44" rx="5" fill="url(#screenGlass)" stroke="#0E3A66" stroke-width="1.2"/>

    <!-- Stand Pedestal & Base Foot -->
    <rect x="56" y="75" width="8" height="8" fill="#082A52" stroke="#00D2FF" stroke-width="1.2"/>
    <path d="M 44 86 C 44 84.5 46 83 48 83 L 72 83 C 74 83 76 84.5 76 86 L 78 88 L 42 88 Z" fill="#04162C" stroke="#00D2FF" stroke-width="1.4"/>
  </g>

  <!-- High-Precision Luminous Sun / Brightness Glyph in LCD Center -->
  <g filter="url(#sun_glow)">
    <!-- Central Solar Core Disc -->
    <circle cx="60" cy="49" r="9" fill="url(#brightSunGrad)" stroke="#FFFFFF" stroke-width="1"/>
    <circle cx="60" cy="49" r="4.5" fill="#FFFFFF"/>

    <!-- 8 Radiating Brightness Spoke Rays -->
    <!-- North / South -->
    <line x1="60" y1="34" x2="60" y2="30" stroke="#00E5FF" stroke-width="2.5" stroke-linecap="round"/>
    <line x1="60" y1="64" x2="60" y2="68" stroke="#00E5FF" stroke-width="2.5" stroke-linecap="round"/>
    <!-- East / West -->
    <line x1="75" y1="49" x2="79" y2="49" stroke="#00E5FF" stroke-width="2.5" stroke-linecap="round"/>
    <line x1="45" y1="49" x2="41" y2="49" stroke="#00E5FF" stroke-width="2.5" stroke-linecap="round"/>
    <!-- Diagonals -->
    <line x1="71" y1="38" x2="74" y2="35" stroke="#FDE047" stroke-width="2" stroke-linecap="round"/>
    <line x1="49" y1="60" x2="46" y2="63" stroke="#FDE047" stroke-width="2" stroke-linecap="round"/>
    <line x1="71" y1="60" x2="74" y2="63" stroke="#FDE047" stroke-width="2" stroke-linecap="round"/>
    <line x1="49" y1="38" x2="46" y2="35" stroke="#FDE047" stroke-width="2" stroke-linecap="round"/>
  </g>
</svg>