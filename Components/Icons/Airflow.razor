 <svg viewBox="0 0 100 100" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <linearGradient id="topArrowGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="#38bdf8" />
                    <stop offset="100%" stop-color="#0284c7" />
                </linearGradient>
                <linearGradient id="bottomArrowGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="#0284c7" />
                    <stop offset="100%" stop-color="#0369a1" />
                </linearGradient>
                <linearGradient id="glassLensGrad" x1="30%" y1="20%" x2="80%" y2="90%">
                    <stop offset="0%" stop-color="#ffffff" stop-opacity="0.7" />
                    <stop offset="60%" stop-color="#e0f2fe" stop-opacity="0.3" />
                    <stop offset="100%" stop-color="#bae6fd" stop-opacity="0.5" />
                </linearGradient>
                <filter id="magShadow" x="-25%" y="-25%" width="150%" height="150%">
                    <feDropShadow dx="0" dy="3.5" stdDeviation="3" flood-color="#ea580c" flood-opacity="0.3" />
                </filter>
            </defs>
            <!-- Flow Direction Arrows in Background -->
            <!-- Upper Inflow Arrow (pointing right) -->
            <path d="M 16 33 L 64 33 M 60 25 L 75 33 L 60 41" fill="none" stroke="url(#topArrowGrad)" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
            
            <!-- Lower Inflow/Downflow Arrow (pointing right) -->
            <path d="M 16 67 L 64 67 M 60 59 L 75 67 L 60 75" fill="none" stroke="url(#bottomArrowGrad)" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />

            <!-- Prominent Inspection Magnifying Glass -->
            <g filter="url(#magShadow)">
                <!-- Lens Ring (Bright Orange rim as in physical HMI) -->
                <circle cx="48" cy="40" r="23" fill="url(#glassLensGrad)" stroke="#f97316" stroke-width="4.5" />
                <!-- Lens Glare Reflection -->
                <path d="M 33 32 A 18 18 0 0 1 54 23" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" opacity="0.85" />

                <!-- Angled Handle pointing down-right -->
                <line x1="64" y1="56" x2="79" y2="76" stroke="#ea580c" stroke-width="7" stroke-linecap="round" />
                <line x1="65" y1="57" x2="78" y2="74" stroke="#fdba74" stroke-width="2.5" stroke-linecap="round" />
            </g>
        </svg>