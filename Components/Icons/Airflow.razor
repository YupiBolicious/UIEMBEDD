<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" width="120" height="120">
  <defs>
    <linearGradient id="esco_bg_mon" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#071E3D"/>
      <stop offset="100%" stop-color="#020B18"/>
    </linearGradient>
    <linearGradient id="esco_lens" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00E5FF" stop-opacity="0.3"/>
      <stop offset="100%" stop-color="#0284C7" stop-opacity="0.1"/>
    </linearGradient>
    <filter id="lens_glow" x="-25%" y="-25%" width="150%" height="150%">
      <feDropShadow dx="0" dy="0" stdDeviation="3.5" flood-color="#00E5FF" flood-opacity="0.5"/>
    </filter>
  </defs>
  <!-- ESCO Outer Bezel -->
  <rect x="2" y="2" width="116" height="116" rx="24" fill="url(#esco_bg_mon)" stroke="#0E3A66" stroke-width="2"/>
  <rect x="5" y="5" width="110" height="110" rx="21" fill="none" stroke="#00D2FF" stroke-width="1" stroke-opacity="0.25"/>

  <!-- Horizontal Airflow Stream Vectors -->
  <!-- Top airflow streamline -->
  <path d="M26 44 L64 44 M57 38 L65 44 L57 50" fill="none" stroke="#00E5FF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
  <!-- Bottom airflow streamline -->
  <path d="M26 76 L52 76 M45 70 L53 76 L45 82" fill="none" stroke="#0284C7" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>

  <!-- Monitoring Inspection Lens -->
  <g filter="url(#lens_glow)">
    <circle cx="64" cy="56" r="21" fill="url(#esco_lens)" stroke="#00E5FF" stroke-width="3.5"/>
    <circle cx="64" cy="56" r="17.5" fill="none" stroke="#FFFFFF" stroke-width="1.2" stroke-opacity="0.5"/>
    <!-- Diagnostic crosshair or lens glint -->
    <path d="M79 71 L94 86" stroke="#00D2FF" stroke-width="5.5" stroke-linecap="round"/>
    <line x1="82" y1="74" x2="91" y2="83" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round"/>
  </g>
</svg>