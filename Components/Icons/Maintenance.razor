<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" width="120" height="120">
  <defs>
    <!-- ESCO Deep Navy Obsidian Glass Background -->
    <linearGradient id="esco_bg_pm" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#071E3D"/>
      <stop offset="100%" stop-color="#020B18"/>
    </linearGradient>

    <!-- Calendar Header Gradient -->
    <linearGradient id="calPmHeaderGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00E5FF"/>
      <stop offset="100%" stop-color="#0284C7"/>
    </linearGradient>

    <!-- Industrial Service Wrench Gradient (Orange/Amber) -->
    <linearGradient id="pmWrenchGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FF7A00"/>
      <stop offset="100%" stop-color="#EA580C"/>
    </linearGradient>

    <!-- Checkmark Neon Gradient -->
    <linearGradient id="checkGlowGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#EF4444"/>
      <stop offset="100%" stop-color="#DC2626"/>
    </linearGradient>

    <!-- Glowing Effects -->
    <filter id="pm_cal_glow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="0" stdDeviation="3.5" flood-color="#00E5FF" flood-opacity="0.45"/>
    </filter>

    <filter id="pm_wrench_glow" x="-25%" y="-25%" width="150%" height="150%">
      <feDropShadow dx="0" dy="0" stdDeviation="3.5" flood-color="#FF7A00" flood-opacity="0.6"/>
    </filter>

    <filter id="check_glow" x="-30%" y="-30%" width="160%" height="160%">
      <feDropShadow dx="0" dy="0" stdDeviation="3" flood-color="#EF4444" flood-opacity="0.75"/>
    </filter>
  </defs>

  <!-- ESCO Outer Bezel -->
  <rect x="2" y="2" width="116" height="116" rx="24" fill="url(#esco_bg_pm)" stroke="#0E3A66" stroke-width="2"/>
  <rect x="5" y="5" width="110" height="110" rx="21" fill="none" stroke="#00D2FF" stroke-width="1" stroke-opacity="0.25"/>

  <!-- 1. Maintenance Schedule Calendar Card (Left) -->
  <g filter="url(#pm_cal_glow)">
    <!-- Calendar Card Base Body -->
    <rect x="18" y="28" width="56" height="60" rx="8" fill="#04162C" stroke="#00D2FF" stroke-width="1.8"/>

    <!-- Calendar Top Header Banner -->
    <path d="M 18 36 C 18 31.5 21.5 28 26 28 L 66 28 C 70.5 28 74 31.5 74 36 L 74 43 L 18 43 Z" fill="url(#calPmHeaderGrad)"/>

    <!-- Top Binder Pegs / Loops (4 Loops styled with luminous cyan caps) -->
    <rect x="24" y="23" width="4" height="9" rx="2" fill="#E0F2FE"/>
    <rect x="36" y="23" width="4" height="9" rx="2" fill="#E0F2FE"/>
    <rect x="48" y="23" width="4" height="9" rx="2" fill="#E0F2FE"/>
    <rect x="60" y="23" width="4" height="9" rx="2" fill="#E0F2FE"/>

    <!-- Subordinate Calendar Pages Depth Effect (Bottom Offset Layers) -->
    <path d="M 21 88 L 71 88 C 73 88 74 89 74 91 L 21 91 Z" fill="#0E3A66" opacity="0.6"/>

    <!-- Inner Inspection / Verification Box -->
    <rect x="26" y="50" width="36" height="32" rx="4" fill="#020B18" stroke="#00D2FF" stroke-width="1.6"/>

    <!-- Radiant Red / Amber Checked Inspection Mark -->
    <path d="M 32 64 L 40 73 L 57 55" fill="none" stroke="#EF4444" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" filter="url(#check_glow)"/>
    <path d="M 32 64 L 40 73 L 57 55" fill="none" stroke="#FCA5A5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
  </g>

  <!-- 2. Industrial Service & Calibration Wrench (Right) -->
  <g filter="url(#pm_wrench_glow)">
    <!-- Wrench Tool Silhouette overlapping the calendar -->
    <path d="M 85 24 C 80 24 76 28 76 33 C 76 36 77.5 38.5 80 40 L 80 78 C 77.5 79.5 76 82 76 85 C 76 91 81 95 87 95 C 93 95 98 91 98 85 C 98 82 96.5 79.5 94 78 L 94 40 C 96.5 38.5 98 36 98 33 C 98 28 94 24 89 24 C 88 24 87 24.5 86 25 L 88 31 L 86 33 L 81 31 L 85 24 Z" fill="url(#pmWrenchGrad)" stroke="#FFE082" stroke-width="1"/>
    <!-- Bottom hanging hole -->
    <circle cx="87" cy="86" r="3.2" fill="#04142B" stroke="#FFE082" stroke-width="1.2"/>
    <!-- Precision metallic ridge line -->
    <line x1="87" y1="44" x2="87" y2="74" stroke="#FFF7ED" stroke-width="1.5" stroke-linecap="round" opacity="0.6"/>
  </g>
</svg>