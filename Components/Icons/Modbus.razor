<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" width="120" height="120">
  <defs>
    <!-- ESCO Deep Navy Obsidian Glass Background -->
    <linearGradient id="esco_bg_modbus" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#071E3D"/>
      <stop offset="100%" stop-color="#020B18"/>
    </linearGradient>

    <!-- Industrial Cabinet Unit Fill & Trim -->
    <linearGradient id="escoCabinetGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0D2E54"/>
      <stop offset="100%" stop-color="#04162B"/>
    </linearGradient>

    <linearGradient id="escoCyanGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00E5FF"/>
      <stop offset="100%" stop-color="#0284C7"/>
    </linearGradient>

    <!-- Glowing Effects -->
    <filter id="cyan_bus_glow" x="-25%" y="-25%" width="150%" height="150%">
      <feDropShadow dx="0" dy="0" stdDeviation="3.5" flood-color="#00E5FF" flood-opacity="0.6"/>
    </filter>

    <filter id="emerald_link_glow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="0" stdDeviation="3" flood-color="#10B981" flood-opacity="0.55"/>
    </filter>
  </defs>

  <!-- ESCO Outer Bezel -->
  <rect x="2" y="2" width="116" height="116" rx="24" fill="url(#esco_bg_modbus)" stroke="#0E3A66" stroke-width="2"/>
  <rect x="5" y="5" width="110" height="110" rx="21" fill="none" stroke="#00D2FF" stroke-width="1" stroke-opacity="0.25"/>

  <!-- 1. Esco Biosafety Cabinet / Controller Unit (Back-Left) -->
  <g id="esco_cabinet">
    <!-- Cabinet Body Frame with industrial perspective trim -->
    <path d="M25 28 L57 28 C60 28 62 30 62 33 L62 76 C62 79 60 81 57 81 L25 81 C22 81 20 79 20 76 L20 33 C20 30 22 28 25 28 Z" fill="url(#escoCabinetGrad)" stroke="#0E3A66" stroke-width="2"/>
    
    <!-- Top Filter Chamber Header -->
    <path d="M22 30 L60 30 L60 41 L22 41 Z" fill="#061A33" stroke="#00D2FF" stroke-width="1.2" stroke-opacity="0.4"/>
    <line x1="28" y1="36" x2="54" y2="36" stroke="#38BDF8" stroke-width="1.5" stroke-dasharray="3 2" stroke-opacity="0.7"/>

    <!-- Distinctive Cyan Sash Window / Work Chamber Band -->
    <rect x="22" y="44" width="38" height="14" rx="2" fill="#00E5FF" fill-opacity="0.18" stroke="#00D2FF" stroke-width="1.5"/>
    <!-- Esco badge capsule on sash -->
    <rect x="36" y="48.5" width="10" height="5" rx="1.5" fill="#00E5FF"/>

    <!-- Bottom Stand / Exhaust Intake Section -->
    <line x1="24" y1="64" x2="58" y2="64" stroke="#0E3A66" stroke-width="1.5"/>
    <rect x="25" y="67" width="9" height="11" rx="1" fill="#030E1D" stroke="#00D2FF" stroke-width="1" stroke-opacity="0.5"/>
  </g>

  <!-- 2. Remote Workstation / Laptop Controller (Front-Right) -->
  <g id="modbus_laptop" filter="url(#cyan_bus_glow)">
    <!-- Laptop Screen Display (Bezel & Inner Glow Display) -->
    <rect x="52" y="44" width="38" height="26" rx="3" fill="#04142B" stroke="#00D2FF" stroke-width="2"/>
    <rect x="55" y="47" width="32" height="20" rx="1.5" fill="#061E3D" stroke="#38BDF8" stroke-width="0.8"/>
    
    <!-- Modbus Telemetry Data Grid on Screen -->
    <line x1="58" y1="52" x2="74" y2="52" stroke="#00E5FF" stroke-width="1.5" stroke-linecap="round"/>
    <line x1="58" y1="57" x2="82" y2="57" stroke="#38BDF8" stroke-width="1.2" stroke-linecap="round" stroke-opacity="0.8"/>
    <line x1="58" y1="62" x2="70" y2="62" stroke="#10B981" stroke-width="1.5" stroke-linecap="round"/>
    <circle cx="80" cy="52" r="1.5" fill="#10B981"/>

    <!-- Laptop Keyboard Base (Perspective Trapezoid) -->
    <path d="M44 76 L98 76 L92 84 L50 84 Z" fill="#072242" stroke="#00D2FF" stroke-width="1.8" stroke-linejoin="round"/>
    <!-- Trackpad highlight -->
    <line x1="66" y1="81" x2="76" y2="81" stroke="#38BDF8" stroke-width="1.5" stroke-linecap="round"/>
  </g>

  <!-- 3. Dynamic Modbus RS485 / Ethernet Bridge Link (Illuminated Data Cable & Signals) -->
  <g id="modbus_link" filter="url(#emerald_link_glow)">
    <!-- High-tech glowing cyan & emerald communication beam crossing from cabinet to remote terminal -->
    <line x1="28" y1="82" x2="88" y2="28" stroke="#00E5FF" stroke-width="4.5" stroke-linecap="round"/>
    <line x1="31" y1="79.3" x2="85" y2="30.7" stroke="#FFFFFF" stroke-width="1.8" stroke-linecap="round"/>

    <!-- Data Packet Pulse Nodes along the Modbus Line -->
    <circle cx="88" cy="28" r="4.5" fill="#00E5FF"/>
    <circle cx="88" cy="28" r="2.2" fill="#FFFFFF"/>

    <circle cx="58" cy="55" r="3.2" fill="#10B981"/>
    <circle cx="58" cy="55" r="1.5" fill="#FFFFFF"/>

    <circle cx="28" cy="82" r="4.5" fill="#00E5FF"/>
    <circle cx="28" cy="82" r="2.2" fill="#FFFFFF"/>
  </g>
</svg>