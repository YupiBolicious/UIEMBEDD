<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" width="120" height="120">
  <defs>
    <!-- ESCO Deep Navy Glass Background -->
    <linearGradient id="bg_exp_timer" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#071E3D"/>
      <stop offset="100%" stop-color="#020B18"/>
    </linearGradient>

    <!-- Emerald Telemetry Gradient -->
    <linearGradient id="emeraldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#34D399"/>
      <stop offset="100%" stop-color="#10B981"/>
    </linearGradient>

    <!-- Flask Solution Gradient -->
    <linearGradient id="flaskLiquid" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00E5FF"/>
      <stop offset="100%" stop-color="#0284C7"/>
    </linearGradient>

    <filter id="exp_glow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="0" stdDeviation="3.5" flood-color="#00E5FF" flood-opacity="0.55"/>
    </filter>

    <filter id="hand_glow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="0" stdDeviation="2.5" flood-color="#10B981" flood-opacity="0.7"/>
    </filter>
  </defs>

  <!-- ESCO Outer Bezel -->
  <rect x="2" y="2" width="116" height="116" rx="24" fill="url(#bg_exp_timer)" stroke="#0E3A66" stroke-width="2"/>
  <rect x="5" y="5" width="110" height="110" rx="21" fill="none" stroke="#00D2FF" stroke-width="1" stroke-opacity="0.25"/>

  <!-- Stopwatch / Timer Circular Instrument Rim -->
  <g filter="url(#exp_glow)">
    <circle cx="56" cy="62" r="30" fill="#04162C" stroke="#0E3A66" stroke-width="2.5"/>
    <circle cx="56" cy="62" r="30" fill="none" stroke="#00D2FF" stroke-width="1.8"/>
    <circle cx="56" cy="62" r="25" fill="#020B18" stroke="#00D2FF" stroke-width="1" stroke-opacity="0.3" stroke-dasharray="2 2"/>

    <!-- Calibrated Timer Ticks -->
    <line x1="56" y1="36" x2="56" y2="42" stroke="#00E5FF" stroke-width="2.5" stroke-linecap="round"/>
    <line x1="82" y1="62" x2="76" y2="62" stroke="#00E5FF" stroke-width="2.5" stroke-linecap="round"/>
    <line x1="56" y1="88" x2="56" y2="82" stroke="#00E5FF" stroke-width="2.5" stroke-linecap="round"/>
    <line x1="30" y1="62" x2="36" y2="62" stroke="#00E5FF" stroke-width="2.5" stroke-linecap="round"/>

    <!-- Stopwatch Top Crown Pusher -->
    <rect x="53" y="24" width="6" height="6" rx="1.5" fill="#38BDF8"/>
    <rect x="51" y="22" width="10" height="3" rx="1" fill="#00E5FF"/>
  </g>

  <!-- Clock / Timer Telemetry Hands -->
  <g filter="url(#hand_glow)">
    <line x1="56" y1="62" x2="43" y2="48" stroke="url(#emeraldGrad)" stroke-width="3.5" stroke-linecap="round"/>
    <line x1="56" y1="62" x2="72" y2="52" stroke="url(#emeraldGrad)" stroke-width="2.8" stroke-linecap="round"/>
    <circle cx="56" cy="62" r="3.5" fill="#04162C" stroke="#00E5FF" stroke-width="1.5"/>
    <circle cx="56" cy="62" r="1.5" fill="#FFFFFF"/>
  </g>

  <!-- Science / Experiment Conical Flask Overlay (Right Foreground) -->
  <g filter="url(#exp_glow)">
    <!-- Flask Outline & Fill -->
    <path d="M 76 46 L 76 53 L 67 69 C 65 72.5 67.5 77 71.5 77 L 89 77 C 93 77 95.5 72.5 93.5 69 L 84 53 L 84 46 Z" fill="#03162E" stroke="#00E5FF" stroke-width="1.8" stroke-linejoin="round"/>
    
    <!-- Lip Lip Collar -->
    <rect x="74" y="44" width="12" height="3" rx="1" fill="#38BDF8"/>
    
    <!-- Active Fluorescent Solution Liquid -->
    <path d="M 70 73 L 73 66 C 76 67.5 83 65 87 67 L 90.5 73 C 91.5 74.5 90.5 76 88.5 76 L 72 76 C 70.5 76 69.5 74.5 70 73 Z" fill="url(#flaskLiquid)" opacity="0.9"/>
    
    <!-- Bubbles -->
    <circle cx="78" cy="71" r="1.5" fill="#FFFFFF"/>
    <circle cx="83" cy="68" r="1" fill="#FFFFFF"/>
  </g>
</svg>