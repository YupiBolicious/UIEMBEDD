<svg viewBox="0 0 100 100" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <linearGradient id="userGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                    <stop offset="0%" stop-color="#bcc1c7" />
                    <stop offset="100%" stop-color="#9aa0a6" />
                </linearGradient>
                <filter id="tileShadow" x="-10%" y="-10%" width="120%" height="125%">
                    <feDropShadow dx="0" dy="2" stdDeviation="2" flood-color="#000000" flood-opacity="0.25" />
                </filter>
            </defs>
            <!-- Grey User Head Silhouette -->
            <circle cx="50" cy="27" r="16" fill="url(#userGrad)" />
            <!-- User Shoulders Silhouette -->
            <path d="M 23 68 C 23 51, 33 46, 50 46 C 67 46, 77 51, 77 68 Z" fill="url(#userGrad)" />
            
            <!-- Front Badge Pill (+ - e) -->
            @* <g filter="url(#tileShadow)">
                <rect x="18" y="58" width="64" height="26" rx="4" fill="#ffffff" stroke="#90a4ae" stroke-width="1.5" />
                <!-- Divider 1 -->
                <line x1="39" y1="58" x2="39" y2="84" stroke="#cfd8dc" stroke-width="1.5" />
                <!-- Divider 2 -->
                <line x1="60" y1="58" x2="60" y2="84" stroke="#cfd8dc" stroke-width="1.5" />
                
                <!-- Plus Sign '+' -->
                <path d="M 28.5 65 L 28.5 77 M 22.5 71 L 34.5 71" stroke="#0077b6" stroke-width="3" stroke-linecap="round" />
                
                <!-- Minus Sign '-' -->
                <line x1="44" y1="71" x2="55" y2="71" stroke="#0077b6" stroke-width="3" stroke-linecap="round" />
                
                <!-- Edit 'e' Sign -->
                <text x="70.5" y="76" font-family="'Segoe UI', Roboto, sans-serif" font-weight="700" font-size="16" fill="#0077b6" text-anchor="middle">e</text>
                <line x1="64" y1="79" x2="77" y2="79" stroke="#0077b6" stroke-width="1.2" />
            </g> *@
        </svg>
