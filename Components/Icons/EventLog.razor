<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" width="120" height="120">
  <defs>
    <!-- ESCO Deep Navy Glass Background -->
    <linearGradient id="bg_event_log" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#071E3D"/>
      <stop offset="100%" stop-color="#020B18"/>
    </linearGradient>

    <!-- Calendar / Board Header Gradient -->
    <linearGradient id="eventHeaderGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00E5FF"/>
      <stop offset="100%" stop-color="#0284C7"/>
    </linearGradient>

    <!-- Verification Checkmark Gradient -->
    <linearGradient id="eventCheckGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#34D399"/>
      <stop offset="100%" stop-color="#10B981"/>
    </linearGradient>

    <filter id="event_board_glow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="0" stdDeviation="3.5" flood-color="#00E5FF" flood-opacity="0.45"/>
    </filter>

    <filter id="check_node_glow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="0" stdDeviation="2.5" flood-color="#10B981" flood-opacity="0.7"/>
    </filter>
  </defs>

  <!-- ESCO Outer Bezel -->
  <rect x="2" y="2" width="116" height="116" rx="24" fill="url(#bg_event_log)" stroke="#0E3A66" stroke-width="2"/>
  <rect x="5" y="5" width="110" height="110" rx="21" fill="none" stroke="#00D2FF" stroke-width="1" stroke-opacity="0.25"/>

  <!-- Audit Event Clipboard / Registry Board Chassis -->
  <g filter="url(#event_board_glow)">
    <!-- Base Registry Board -->
    <rect x="24" y="25" width="72" height="72" rx="8" fill="#04162C" stroke="#00D2FF" stroke-width="1.8"/>

    <!-- Clipboard Top Mechanical Clamp Header -->
    <rect x="42" y="20" width="36" height="9" rx="3" fill="#082A52" stroke="#00D2FF" stroke-width="1.5"/>
    <circle cx="60" cy="24.5" r="2.2" fill="#E0F2FE"/>

    <!-- Event Audit Rows / Activity Timeline Streams -->
    <!-- Row 1 (Completed Event) -->
    <rect x="32" y="38" width="10" height="10" rx="2.5" fill="#020B18" stroke="#10B981" stroke-width="1.2"/>
    <line x1="48" y1="43" x2="84" y2="43" stroke="#38BDF8" stroke-width="2" stroke-linecap="round"/>

    <!-- Row 2 (Routine Operating Event) -->
    <rect x="32" y="55" width="10" height="10" rx="2.5" fill="#020B18" stroke="#00E5FF" stroke-width="1.2"/>
    <line x1="48" y1="60" x2="76" y2="60" stroke="#0E3A66" stroke-width="2" stroke-linecap="round"/>

    <!-- Row 3 (Maintenance / Audit Action Event) -->
    <rect x="32" y="72" width="10" height="10" rx="2.5" fill="#020B18" stroke="#F59E0B" stroke-width="1.2"/>
    <line x1="48" y1="77" x2="80" y2="77" stroke="#0E3A66" stroke-width="2" stroke-linecap="round"/>
  </g>

  <!-- Interactive Luminous Status Checkmarks & Indicators in Checkboxes -->
  <g filter="url(#check_node_glow)">
    <!-- Checkmark in Row 1 -->
    <path d="M 34.5 43 L 36.5 45.5 L 40.5 40" fill="none" stroke="url(#eventCheckGrad)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>

    <!-- Active Dot in Row 2 -->
    <circle cx="37" cy="60" r="2" fill="#00E5FF"/>

    <!-- Warning / Alert Dot in Row 3 -->
    <circle cx="37" cy="77" r="2" fill="#F59E0B"/>
  </g>
</svg>