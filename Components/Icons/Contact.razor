<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" width="120" height="120">
  <defs>
    <!-- ESCO Standard Squircle Background Gradient -->
    <linearGradient id="cu_bg3" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#071E3D"/>
      <stop offset="100%" stop-color="#020B18"/>
    </linearGradient>

    <!-- Inner Recessed Plate Gradient -->
    <linearGradient id="cu_plate3" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#061830"/>
      <stop offset="100%" stop-color="#020C1A"/>
    </linearGradient>

    <!-- Electric Cyan Gradient for User & Phone Glyphs -->
    <linearGradient id="cyan_cu_grad3" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#38BDF8"/>
      <stop offset="100%" stop-color="#00E5FF"/>
    </linearGradient>

    <!-- Ambient Cyan Glow Filter -->
    <filter id="cu_cyan_glow3" x="-30%" y="-30%" width="160%" height="160%">
      <feDropShadow dx="0" dy="0" stdDeviation="3.2" flood-color="#00E5FF" flood-opacity="0.75"/>
      <feDropShadow dx="0" dy="0" stdDeviation="1.2" flood-color="#BAE6FD" flood-opacity="0.85"/>
    </filter>
  </defs>

  <!-- ESCO Standard Squircle Bezel (120x120, rx=24) -->
  <rect x="2" y="2" width="116" height="116" rx="24" fill="url(#cu_bg3)" stroke="#0E3A66" stroke-width="2"/>
  <rect x="5" y="5" width="110" height="110" rx="21" fill="none" stroke="#00D2FF" stroke-width="1" stroke-opacity="0.35"/>

  <!-- Inner Recessed Panel -->
  <rect x="16" y="16" width="88" height="88" rx="18" fill="url(#cu_plate3)" stroke="#0A2C52" stroke-width="1.2"/>
  <rect x="18" y="18" width="84" height="84" rx="16" fill="none" stroke="#00E5FF" stroke-width="0.8" stroke-opacity="0.2"/>

  <!-- Subtle Concentric Telemetry Guide Ring -->
  <circle cx="60" cy="60" r="33" fill="none" stroke="#0E3A66" stroke-width="1" stroke-dasharray="3 3" opacity="0.6"/>

  <!-- Combined User Profile + Phone Handset Facing Inward -->
  <g filter="url(#cu_cyan_glow3)">
    <!-- 1. Operator / User Profile on the Left -->
    <!-- Head Circle -->
    <circle cx="39" cy="45" r="9.5" 
            fill="#03254A" 
            fill-opacity="0.75" 
            stroke="url(#cyan_cu_grad3)" 
            stroke-width="2.5"/>
    <!-- Specular highlight on head -->
    <path d="M 34 41 C 36 38 42 38 44 41" 
          fill="none" 
          stroke="#FFFFFF" 
          stroke-width="1" 
          stroke-linecap="round" 
          opacity="0.6"/>

    <!-- Torso / Shoulder Silhouette matching Users icon language -->
    <path d="M 24 75 C 24 65.5 30 61.5 39 61.5 C 48 61.5 54 65.5 54 75 C 54 76.8 53 78 50 78 L 28 78 C 25 78 24 76.8 24 75 Z" 
          fill="#03254A" 
          fill-opacity="0.75" 
          stroke="url(#cyan_cu_grad3)" 
          stroke-width="2.5" 
          stroke-linejoin="round"/>
    
    <!-- Subtle collar accent -->
    <path d="M 31 74 C 34 69 44 69 47 74" 
          fill="none" 
          stroke="url(#cyan_cu_grad3)" 
          stroke-width="1.2" 
          stroke-linecap="round" 
          opacity="0.5"/>

    <!-- 2. Distinct Classic Telephone Handset Facing TOWARDS the Person (curved cups oriented inward toward user) -->
    <!-- Handset mirrored horizontally so earpiece and mouthpiece cup inward toward x=39, handle curves outward right -->
    <path d="M 75 38
             C 70 38 65 41 65 45.5
             C 65 48 67 50.5 70 51.5
             L 73 52.5
             C 75.5 54 76 56.5 75.5 59.5
             C 75 62.5 74 64.5 72 66
             L 69 67
             C 66 68 64 70.5 64 73.5
             C 64 78 69 81 74 81
             C 80.5 81 84 74.5 84 67.5
             C 84 52.5 80.5 38 75 38 Z" 
          fill="#03254A" 
          fill-opacity="0.75" 
          stroke="url(#cyan_cu_grad3)" 
          stroke-width="2.5" 
          stroke-linejoin="round"/>

    <!-- Inner ear/mouth acoustic slot accents facing inward toward the operator -->
    <line x1="71.5" y1="43" x2="68.5" y2="44.5" stroke="url(#cyan_cu_grad3)" stroke-width="1.5" stroke-linecap="round" opacity="0.8"/>
    <line x1="70.5" y1="74.5" x2="67.5" y2="76" stroke="url(#cyan_cu_grad3)" stroke-width="1.5" stroke-linecap="round" opacity="0.8"/>

    <!-- Telemetry communication waves radiating toward the operator between phone and user -->
    <path d="M 60 50 C 57 55.5 57 63.5 60 69" 
          fill="none" 
          stroke="url(#cyan_cu_grad3)" 
          stroke-width="2.2" 
          stroke-linecap="round" 
          opacity="0.85"/>
    <path d="M 55 46 C 51 53 51 66 55 73" 
          fill="none" 
          stroke="url(#cyan_cu_grad3)" 
          stroke-width="1.6" 
          stroke-linecap="round" 
          stroke-dasharray="2.5 3"
          opacity="0.65"/>
  </g>

  <!-- Ambient cyan floor glow -->
  <ellipse cx="58" cy="82" rx="20" ry="3" fill="#00E5FF" fill-opacity="0.15" filter="blur(4px)"/>
</svg>