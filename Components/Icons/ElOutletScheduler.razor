<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" width="120" height="120">
  <defs>
    <!-- ESCO Deep Navy Glass Background -->
    <linearGradient id="esco_bg_eo" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#071E3D"/>
      <stop offset="100%" stop-color="#020B18"/>
    </linearGradient>

    <!-- Calendar Header Gradient (ESCO Cyan) -->
    <linearGradient id="eoHeaderGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00E5FF"/>
      <stop offset="100%" stop-color="#0284C7"/>
    </linearGradient>

    <!-- Lightning / Energy Gradient -->
    <linearGradient id="lightningGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FDE047"/>
      <stop offset="100%" stop-color="#F59E0B"/>
    </linearGradient>

    <filter id="eo_cal_glow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="0" stdDeviation="3.5" flood-color="#00E5FF" flood-opacity="0.45"/>
    </filter>

    <filter id="plug_glow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="0" stdDeviation="3" flood-color="#00E5FF" flood-opacity="0.6"/>
    </filter>

    <filter id="bolt_glow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="0" stdDeviation="3" flood-color="#FDE047" flood-opacity="0.7"/>
    </filter>
  </defs>

  <!-- ESCO Outer Bezel -->
  <rect x="2" y="2" width="116" height="116" rx="24" fill="url(#esco_bg_eo)" stroke="#0E3A66" stroke-width="2"/>
  <rect x="5" y="5" width="110" height="110" rx="21" fill="none" stroke="#00D2FF" stroke-width="1" stroke-opacity="0.25"/>

  <!-- Calendar Schedule Chassis -->
  <g filter="url(#eo_cal_glow)">
    <!-- Calendar Card Base -->
    <rect x="22" y="27" width="76" height="66" rx="10" fill="#04162C" stroke="#00D2FF" stroke-width="1.8"/>

    <!-- Calendar Header Banner -->
    <path d="M 22 37 C 22 31.5 26.5 27 32 27 L 88 27 C 93.5 27 98 31.5 98 37 L 98 44 L 22 44 Z" fill="url(#eoHeaderGrad)"/>

    <!-- Binder Loops / Pegs -->
    <rect x="34" y="22" width="4.5" height="9" rx="2" fill="#E0F2FE"/>
    <rect x="58" y="22" width="4.5" height="9" rx="2" fill="#E0F2FE"/>
    <rect x="82" y="22" width="4.5" height="9" rx="2" fill="#E0F2FE"/>

    <!-- Central Dial Circular Ring -->
    <circle cx="60" cy="67" r="18" fill="#020B18" stroke="#0E3A66" stroke-width="2"/>
    <circle cx="60" cy="67" r="18" fill="none" stroke="#00D2FF" stroke-width="1.2" stroke-dasharray="3 2" opacity="0.6"/>
  </g>

  <!-- Industrial Electrical Outlet / Plug Socket with Lightning Bolt -->
  <g filter="url(#plug_glow)">
    <!-- Power Plug Body Capsule (angled slightly or upright) -->
    <rect x="52" y="58" width="16" height="18" rx="4" fill="#072242" stroke="#00D2FF" stroke-width="1.6"/>
    <!-- Outlet Terminal Prongs -->
    <rect x="54.5" y="52" width="3" height="7" rx="1" fill="#38BDF8"/>
    <rect x="62.5" y="52" width="3" height="7" rx="1" fill="#38BDF8"/>
  </g>

  <!-- Luminous High-Voltage Energy Bolt Overlay -->
  <g filter="url(#bolt_glow)">
    <polygon points="62,56 54,68 59,68 57,78 66,66 61,66" fill="url(#lightningGrad)" stroke="#FFFFFF" stroke-width="0.8"/>
  </g>
</svg>