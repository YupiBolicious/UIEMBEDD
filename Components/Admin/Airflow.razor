@page "/admin/airflow"
@inject NavigationManager Nav
@rendermode InteractiveServer

<div class="hmi-shell">
    <InnerTopBar Title="Airflow Monitor"/>
        <main class="hmi-monitor-workspace">
            
            <!-- Modernized Glowing Airflow Monitor Card -->
            <div class="hmi-monitor-card @(IsMonitorEnabled ? "card-enabled" : "card-disabled")">
                <div class="hmi-control-row">
                    
                    <!-- Monitor Graphic (Bezel + Fan Impeller + Bidirectional Airflow Arrows) -->
                    <div class="hmi-terminal-graphic">
                        <div class="terminal-bezel @(IsMonitorEnabled ? "" : "terminal-bezel-disabled")">
                            <div class="terminal-screen-interior">
                                
                                <!-- Fan Impeller Vector -->
                                <svg class="fan-icon @(IsMonitorEnabled ? "fan-spinning" : "opacity-40")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="12" r="3" fill="currentColor"/>
                                    <path d="M12 9a3 3 0 0 0-3-3H6a3 3 0 0 0 3 3h3z" fill="currentColor" fill-opacity="0.3"/>
                                    <path d="M15 12a3 3 0 0 0 3-3V6a3 3 0 0 0-3 3v3z" fill="currentColor" fill-opacity="0.3"/>
                                    <path d="M12 15a3 3 0 0 0 3 3h3a3 3 0 0 0-3-3h-3z" fill="currentColor" fill-opacity="0.3"/>
                                    <path d="M9 12a3 3 0 0 0-3 3v3a3 3 0 0 0 3-3v-3z" fill="currentColor" fill-opacity="0.3"/>
                                </svg>

                                <!-- Horizontal Airflow Velocity Arrows -->
                                <div class="flow-arrows-container">
                                    <!-- Upper Flow Arrow -->
                                    <svg class="flow-arrow-bar arrow-anim-1 text-sky-400" viewBox="0 0 40 8" fill="none">
                                        <line x1="0" y1="4" x2="32" y2="4" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/>
                                        <polygon points="30,1 38,4 30,7" fill="currentColor"/>
                                    </svg>
                                    <!-- Lower Flow Arrow -->
                                    <svg class="flow-arrow-bar arrow-anim-2 text-emerald-400" viewBox="0 0 40 8" fill="none">
                                        <line x1="0" y1="4" x2="32" y2="4" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/>
                                        <polygon points="30,1 38,4 30,7" fill="currentColor"/>
                                    </svg>
                                </div>

                            </div>
                        </div>
                        <!-- Monitor Stand Neck & Base -->
                        <div class="terminal-stand-neck"></div>
                        <div class="terminal-stand-base"></div>
                    </div>

                    <!-- Dropdown Select Box verbatim from reference: "Enable" / "Disable" -->
                    <div class="hmi-select-container">
                        <span class="hmi-select-label">AIRFLOW MONITOR</span>
                        <div class="hmi-select-box">
                            <select value="@SelectedOption" @onchange="OnStatusSelectionChanged" class="hmi-dropdown">
                                <option value="Enable">Enable</option>
                                <option value="Disable">Disable</option>
                            </select>
                            <!-- Dropdown Chevron Caret -->
                            <div class="hmi-select-chevron">
                                <svg class="w-5 h-5 stroke-[3]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                                </svg>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- Dynamic Status Caption Underneath -->
                @* <div class="hmi-status-caption">
                    @if (IsMonitorEnabled)
                    {
                        <span class="text-sky-200">
                            Audible & visual velocity deviation alarms engaged. Auto-recalibration active.
                        </span>
                    }
                    else
                    {
                        <span class="text-amber-300">
                            Warning: Airflow monitoring alarms deactivated. Operates under manual supervision.
                        </span>
                    }
                </div> *@

                <!-- Sensor Telemetry Chips Grid -->
                <div class="hmi-sensor-telemetry-row">
                    <div class="hmi-telemetry-chip">
                        <span class="telemetry-chip-label">Inflow Target</span>
                        <span class="telemetry-chip-val text-sky-300">@InflowTarget</span>
                    </div>
                    <div class="hmi-telemetry-chip">
                        <span class="telemetry-chip-label">Downflow Target</span>
                        <span class="telemetry-chip-val text-emerald-300">@DownflowTarget</span>
                    </div>
                    <div class="hmi-telemetry-chip">
                        <span class="telemetry-chip-label">Compliance</span>
                        <span class="telemetry-chip-val text-white">EN 12469 / NSF 49</span>
                    </div>
                </div>

            </div>

        </main>

        <!-- 3. Bottom HMI Navigation & Footer Dock -->
        <footer class="hmi-footer">
            <!-- Tactile Back Navigation Button verbatim from reference -->
            <button type="button" @onclick="NavigateBack" class="hmi-button">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
                </svg>
                <span>Back</span>
            </button>
        </footer>
</div>

@code {
    [Parameter] public string SelectedOption { get; set; } = "Enable";
    [Parameter] public EventCallback<string> SelectedOptionChanged { get; set; }

    public bool IsMonitorEnabled => SelectedOption.Equals("Enable", StringComparison.OrdinalIgnoreCase);
    [Parameter] public string InflowTarget { get; set; } = "0.45 m/s";
    [Parameter] public string DownflowTarget { get; set; } = "0.32 m/s";
    [Parameter] public DateTime CurrentTime { get; set; } = new DateTime(2026, 9, 28, 11, 24, 0);
    [Parameter] public EventCallback<bool> OnMonitorStateChanged { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }

    private async Task OnStatusSelectionChanged(ChangeEventArgs e)
    {
        SelectedOption = e.Value?.ToString() ?? "Enable";
        if (SelectedOptionChanged.HasDelegate)
        {
            await SelectedOptionChanged.InvokeAsync(SelectedOption);
        }

        if (OnMonitorStateChanged.HasDelegate)
        {
            await OnMonitorStateChanged.InvokeAsync(IsMonitorEnabled);
        }
    }

    private async Task NavigateBack()
    {
        Nav.NavigateTo("/admin");
    }
}
