@page "/admin/timesetting"
@inject NavigationManager Nav
@rendermode InteractiveServer

<div class="hmi-shell">
    <InnerTopBar Title="Time Setting"/>
        <main class="hmi-time-workspace">        
            @if (!IsPickerActive)
            {
                <div class="hmi-state-fade-in flex flex-col items-center w-full">    
                    <div class="hmi-time-card" 
                         @onclick="OpenInlinePicker" 
                         role="button" 
                         tabindex="0"
                         title="Tap to adjust time">
                        
                        <div class="hmi-time-content-row">
                            <div class="hmi-clock-badge-container">
                                <div class="hmi-clock-icon-tile">
                                    <svg class="hmi-clock-svg" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <defs>
                                            <linearGradient id="clockOuterRingGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                                                <stop offset="0%" stop-color="#38bdf8" />
                                                <stop offset="50%" stop-color="#0284c7" />
                                                <stop offset="100%" stop-color="#0369a1" />
                                            </linearGradient>
                                            <radialGradient id="clockDialGlassGrad" cx="35%" cy="35%" r="65%">
                                                <stop offset="0%" stop-color="#052c54" />
                                                <stop offset="70%" stop-color="#021a36" />
                                                <stop offset="100%" stop-color="#011024" />
                                            </radialGradient>
                                            <filter id="clockTileGlow" x="-20%" y="-20%" width="140%" height="140%">
                                                <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#0284c7" flood-opacity="0.4" />
                                            </filter>
                                        </defs>
                                        @* CLOCK ICON *@
                                        <g filter="url(#clockTileGlow)">
                                            <!-- Bezel Outer Ring -->
                                            <circle cx="50" cy="50" r="44" stroke="url(#clockOuterRingGrad)" stroke-width="3" />
                                            <!-- Dial Background Face -->
                                            <circle cx="50" cy="50" r="41" fill="url(#clockDialGlassGrad)" />
                                            
                                            <!-- 12-Hour Calibration Micro Tick Marks -->
                                            <line x1="50" y1="13" x2="50" y2="18" stroke="#38bdf8" stroke-width="2.5" stroke-linecap="round" />
                                            <line x1="87" y1="50" x2="82" y2="50" stroke="#38bdf8" stroke-width="2.5" stroke-linecap="round" />
                                            <line x1="50" y1="87" x2="50" y2="82" stroke="#38bdf8" stroke-width="2.5" stroke-linecap="round" />
                                            <line x1="13" y1="50" x2="18" y2="50" stroke="#38bdf8" stroke-width="2.5" stroke-linecap="round" />
                                            <!-- Hour Hand -->
                                            <line x1="50" y1="50" x2="68" y2="38" stroke="#ffffff" stroke-width="4.5" stroke-linecap="round" />
                                            <!-- Minute Hand -->
                                            <line x1="50" y1="50" x2="72" y2="65" stroke="#38bdf8" stroke-width="3.5" stroke-linecap="round" />
                                            <!-- Glowing Green Emerald Second Hand -->
                                            <line x1="50" y1="50" x2="32" y2="74" stroke="#4ade80" stroke-width="2" stroke-linecap="round" class="clock-sec-hand" />
                                            <!-- Center Axis Pin -->
                                            <circle cx="50" cy="50" r="4.5" fill="#0284c7" stroke="#ffffff" stroke-width="1.8" />
                                        </g>
                                    </svg>
                                </div>
                            </div>

                            <!-- Right: Current Time Readout verbatim -->
                            <div class="hmi-time-text-container">
                                <span class="hmi-time-label">Current time:</span>
                                
                                <div class="hmi-time-value">
                                    <span class="time-digits">@DisplayedTimeString</span>
                                </div>

                                <div class="hmi-tap-to-change">
                                    <span>Tap to change</span
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            }
            else
            {
                <!-- STATE B: INLINE TIME PICKER (Transitioned in-place without page routing) -->
                <div class="hmi-state-fade-in flex flex-col items-center w-full">
                    
                    <div class="hmi-picker-container">

                        <!-- Drum Wheel Time Picker Columns -->
                        <div class="picker-wheels-assembly">
                            
                            <!-- Focus Glass Loupe Band across the 3 wheels -->
                            <div class="picker-focus-loupe"></div>

                            <!-- Column 1: Hours -->
                            <div class="wheel-column">
                                <span class="wheel-label">HOURS</span>
                                <button type="button" @onclick="() => StepHours(1)" class="wheel-arrow-btn" title="Increment Hours">
                                    <svg class="w-5 h-5 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M4.5 15.75l7.5-7.5 7.5 7.5" /></svg>
                                </button>
                                
                                <div class="wheel-slot-container">
                                    <span class="wheel-num-preview">@GetHourOffset(-1).ToString("D2")</span>
                                    <span class="wheel-num-active">@PickerHour.ToString("D2")</span>
                                    <span class="wheel-num-preview">@GetHourOffset(1).ToString("D2")</span>
                                </div>

                                <button type="button" @onclick="() => StepHours(-1)" class="wheel-arrow-btn" title="Decrement Hours">
                                    <svg class="w-5 h-5 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
                                </button>
                            </div>

                            <!-- Colon Separator -->
                            <div class="wheel-separator">:</div>

                            <!-- Column 2: Minutes -->
                            <div class="wheel-column">
                                <span class="wheel-label">MINUTES</span>
                                <button type="button" @onclick="() => StepMinutes(1)" class="wheel-arrow-btn" title="Increment Minutes">
                                    <svg class="w-5 h-5 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M4.5 15.75l7.5-7.5 7.5 7.5" /></svg>
                                </button>
                                
                                <div class="wheel-slot-container">
                                    <span class="wheel-num-preview">@GetMinuteOffset(-1).ToString("D2")</span>
                                    <span class="wheel-num-active">@PickerMinute.ToString("D2")</span>
                                    <span class="wheel-num-preview">@GetMinuteOffset(1).ToString("D2")</span>
                                </div>

                                <button type="button" @onclick="() => StepMinutes(-1)" class="wheel-arrow-btn" title="Decrement Minutes">
                                    <svg class="w-5 h-5 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
                                </button>
                            </div>

                            <!-- Colon Separator -->
                            <div class="wheel-separator">:</div>

                            <!-- Column 3: Seconds -->
                            <div class="wheel-column">
                                <span class="wheel-label">SECONDS</span>
                                <button type="button" @onclick="() => StepSeconds(1)" class="wheel-arrow-btn" title="Increment Seconds">
                                    <svg class="w-5 h-5 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M4.5 15.75l7.5-7.5 7.5 7.5" /></svg>
                                </button>
                                
                                <div class="wheel-slot-container">
                                    <span class="wheel-num-preview">@GetSecondOffset(-1).ToString("D2")</span>
                                    <span class="wheel-num-active text-sky-200">@PickerSecond.ToString("D2")</span>
                                    <span class="wheel-num-preview">@GetSecondOffset(1).ToString("D2")</span>
                                </div>

                                <button type="button" @onclick="() => StepSeconds(-1)" class="wheel-arrow-btn" title="Decrement Seconds">
                                    <svg class="w-5 h-5 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
                                </button>
                            </div>

                        </div>

                        <!-- Picker Actions: Cancel (Back to Current Time) / Apply (Save) -->
                        <div class="picker-actions-row">
                            <button type="button" @onclick="CancelPicker" class="hmi-button-cancel">
                                <svg class="w-4 h-4 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                </svg>
                                <span>Cancel</span>
                            </button>

                            <div class="flex items-center gap-1">
                                <button type="button" @onclick="ApplyTime" class="hmi-button">
                                    <span>Apply</span>
                                </button>
                            </div>
                        </div>

                    </div>

                </div>
            }

        </main>

        <!-- 3. Bottom HMI Navigation & Footer Dock -->
        <footer class="hmi-footer">
            <button type="button" @onclick="HandleFooterBack" class="hmi-button">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
                </svg>
                <span>@(IsPickerActive ? "Discard" : "Back")</span>
            </button>
        </footer>
</div>

@code {
    [Parameter] public string DisplayedTimeString { get; set; } = "14:23:17";
    [Parameter] public EventCallback<string> DisplayedTimeStringChanged { get; set; }

    [Parameter] public string FormatMode { get; set; } = "24h";
    [Parameter] public EventCallback<string> FormatModeChanged { get; set; }
    [Parameter] public DateTime CurrentTime { get; set; } = new DateTime(2026, 9, 21, 14, 23, 17);
    [Parameter] public EventCallback OnBack { get; set; }

    private bool IsPickerActive = false;

    // Time picker cylinder values
    private int PickerHour = 14;
    private int PickerMinute = 23;
    private int PickerSecond = 17;
    private string PickerAmPm = "PM";

    protected override void OnInitialized()
    {
        ParseTimeString(DisplayedTimeString);
    }

    private void ParseTimeString(string timeStr)
    {
        if (TimeSpan.TryParse(timeStr, out var ts))
        {
            PickerHour = ts.Hours;
            PickerMinute = ts.Minutes;
            PickerSecond = ts.Seconds;
            PickerAmPm = (PickerHour >= 12) ? "PM" : "AM";
        }
    }

    private void OpenInlinePicker()
    {
        ParseTimeString(DisplayedTimeString);
        IsPickerActive = true;
    }

    private void CancelPicker()
    {
        IsPickerActive = false;
    }

    private async Task ApplyTime()
    {
        var h = PickerHour;

        DisplayedTimeString = $"{h:D2}:{PickerMinute:D2}:{PickerSecond:D2}";
        CurrentTime = new DateTime(CurrentTime.Year, CurrentTime.Month, CurrentTime.Day, h, PickerMinute, PickerSecond);
        
        if (DisplayedTimeStringChanged.HasDelegate)
        {
            await DisplayedTimeStringChanged.InvokeAsync(DisplayedTimeString);
        }

        // Return back to Current Time view with updated values
        IsPickerActive = false;
    }


    private void StepHours(int delta)
    {
        var max = (FormatMode == "12h") ? 12 : 23;
        var min = (FormatMode == "12h") ? 1 : 0;
        
        PickerHour += delta;
        if (PickerHour > max) PickerHour = min;
        else if (PickerHour < min) PickerHour = max;
    }

    private void StepMinutes(int delta)
    {
        PickerMinute = (PickerMinute + delta + 60) % 60;
    }

    private void StepSeconds(int delta)
    {
        PickerSecond = (PickerSecond + delta + 60) % 60;
    }

    private int GetHourOffset(int offset)
    {
        var max = (FormatMode == "12h") ? 12 : 23;
        var min = (FormatMode == "12h") ? 1 : 0;
        var val = PickerHour + offset;
        if (val > max) return min;
        if (val < min) return max;
        return val;
    }

    private int GetMinuteOffset(int offset)
    {
        return (PickerMinute + offset + 60) % 60;
    }

    private int GetSecondOffset(int offset)
    {
        return (PickerSecond + offset + 60) % 60;
    }

    private void SetAmPm(string ampm)
    {
        PickerAmPm = ampm;
    }

    private async Task SetFormatMode(string mode)
    {
        FormatMode = mode;
        if (FormatModeChanged.HasDelegate)
        {
            await FormatModeChanged.InvokeAsync(FormatMode);
        }
    }


    private async Task HandleFooterBack()
    {
        if (IsPickerActive)
        {
            // Transition back to overview inside the component
            IsPickerActive = false;
        }
        else
        {
            if (OnBack.HasDelegate)
            {
                await OnBack.InvokeAsync();
            }
            else
            {
                Nav.NavigateTo("/admin");
            }
        }
    }
}
