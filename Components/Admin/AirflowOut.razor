@page "/admin/airflowout"
@rendermode InteractiveServer
@inject NavigationManager Nav


<div class="hmi-shell">
    <InnerTopBar Title="Airflow Out Temperature"/>
        <main class="hmi-monitor-workspace">
            
            <!-- Modernized Glowing Airflow Out Card -->
            <div class="hmi-monitor-card @(IsTempSensorEnabled ? "card-enabled" : "card-disabled")">
                
                <!-- Primary Control Row: Airflow Out Temperature Vector + Dropdown Selector -->
                <div class="hmi-control-row">
                    
                    <!-- Airflow Out Temperature Vector Graphic verbatim from reference photo:
                         Sash/Plenum with green outward airflow arrows + Thermometer Sensor -->
                    <div class="hmi-airflow-out-graphic">
                        <div class="graphic-bezel @(IsTempSensorEnabled ? "" : "graphic-bezel-disabled")">
                            
                            <!-- Left: Cabinet Sash Profile with 2 Outward Green Airflow Vectors -->
                            <div class="cabinet-sash-zone">
                               <AirflowOut Width="128px" Height="128px"/>
                            </div>

                            <!-- Right: Industrial Temperature Sensor Thermometer -->
                            <div class="thermometer-zone">
                               <Thermometer Width="50px" Height="128px"/>
                            </div>

                        </div>
                    </div>

                    <!-- Dropdown Select Box verbatim from reference: "Disable" / "Enable" -->
                    <div class="hmi-select-container">
                        <span class="hmi-select-label">AIRFLOW OUT TEMP</span>
                        <div class="hmi-select-box">
                            <select value="@SelectedOption" @onchange="OnStatusSelectionChanged" class="hmi-dropdown">
                                <option value="Disable">Disable</option>
                                <option value="Enable">Enable</option>
                            </select>
                            <!-- Dropdown Chevron Caret -->
                            <div class="hmi-select-chevron">
                                <svg class="w-5 h-5 stroke-[3]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                                </svg>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- Dynamic Status Caption Underneath -->
                <div class="hmi-status-caption">
                    @if (IsTempSensorEnabled)
                    {
                        <span class="text-sky-200">
                            Exhaust air thermal sensor active. Real-time temperature telemetry monitored.
                        </span>
                    }
                    else
                    {
                        <span class="text-amber-300">
                            Airflow Out Temperature sensor disabled. Exhaust thermal alarms muted.
                        </span>
                    }
                </div>

                <!-- Sensor Telemetry Chips Grid -->
                <div class="hmi-sensor-telemetry-row">
                    <div class="hmi-telemetry-chip">
                        <span class="telemetry-chip-label">Exhaust Temp</span>
                        <span class="telemetry-chip-val text-amber-300">@(IsTempSensorEnabled ? CurrentExhaustTemp : "-- °C")</span>
                    </div>
                    <div class="hmi-telemetry-chip">
                        <span class="telemetry-chip-label">Upper Limit</span>
                        <span class="telemetry-chip-val text-sky-300">40.0 °C</span>
                    </div>
                    <div class="hmi-telemetry-chip">
                        <span class="telemetry-chip-label">Sensor Type</span>
                        <span class="telemetry-chip-val text-white">NTC Thermistor</span>
                    </div>
                </div>

            </div>

        </main>
        <footer class="hmi-footer">
            <button type="button" @onclick="NavigateBack" class="hmi-button">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
                </svg>
                <span>Back</span>
            </button>
        </footer>
</div>

@code {
    [Parameter] public string SelectedOption { get; set; } = "Disable";
    [Parameter] public EventCallback<string> SelectedOptionChanged { get; set; }
    public bool IsTempSensorEnabled => SelectedOption.Equals("Enable", StringComparison.OrdinalIgnoreCase);
    [Parameter] public string CurrentExhaustTemp { get; set; } = "28.4 °C";
    [Parameter] public DateTime CurrentTime { get; set; } = new DateTime(2026, 9, 28, 11, 24, 0);
    [Parameter] public EventCallback<bool> OnTempSensorStateChanged { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }

    private async Task OnStatusSelectionChanged(ChangeEventArgs e)
    {
        SelectedOption = e.Value?.ToString() ?? "Disable";
        if (SelectedOptionChanged.HasDelegate)
        {
            await SelectedOptionChanged.InvokeAsync(SelectedOption);
        }

        if (OnTempSensorStateChanged.HasDelegate)
        {
            await OnTempSensorStateChanged.InvokeAsync(IsTempSensorEnabled);
        }
    }

    private async Task NavigateBack()
    {
        if (OnBack.HasDelegate)
        {
            await OnBack.InvokeAsync();
        }
        else
        {
            Nav.NavigateTo("/admin");
        }
    }
}
